---
import { waitUntil } from "cloudflare:workers";
import HomepageContent from "../components/HomepageContent.svelte";
import NavLocationPicker from "../components/NavLocationPicker.svelte";
import Layout from "../layouts/Layout.astro";
import {
    combinePublicDataCacheStates,
    publicDataCacheResponseHeaders,
    type PublicDataCacheState
} from "../lib/cache/public-data";
import {
    loadCachedHomepageDiscovery,
    loadCachedHomepagePopularity
} from "../lib/cache/public-routes";
import { getDB } from "../lib/db";
import { listHomepageDiscovery, listHomepagePopularity } from "../lib/db/homepage";
import { FALLBACK_DIVISION_CODE, getRegionOptionByCode, type RegionOption } from "../lib/divisions";
import { parsePopularityWindow } from "../lib/events/popularity";
import { resolveSelectedDivision } from "../lib/geo";
import {
    toPublicHomepageDiscovery,
    toPublicHomepagePopularity,
    type PublicHomepageData,
    type PublicHomepageDiscovery,
    type PublicHomepagePopularity
} from "../lib/public/homepage";
import { getRuntimeEnv } from "../lib/runtime/env";

export const prerender = false;

const runtimeEnv = getRuntimeEnv();
const defaultDivisionCode = runtimeEnv.DEFAULT_DIVISION_CODE || FALLBACK_DIVISION_CODE;
const trendWindow = parsePopularityWindow(Astro.url.searchParams.get("trend"));
let selectedDivision: RegionOption | null = null;
let sourceLabel = "默认城市";
let regionError = "";
let discoveryError = "";
let popularityError = "";
let cacheWarning = "";
let discovery: PublicHomepageDiscovery = { featuredEvents: [] };
let popularity: PublicHomepagePopularity = {
    window: trendWindow,
    unopened: { local: [], nationwide: [] },
    unended: { local: [], nationwide: [] }
};
const cacheStates: PublicDataCacheState[] = [];

try {
    const resolved = await resolveSelectedDivision(
        Astro.request,
        Astro.url.searchParams,
        defaultDivisionCode
    );
    selectedDivision = resolved.division;
    sourceLabel =
        resolved.source === "query"
            ? "手动选择"
            : resolved.source === "cf"
              ? "IP 定位"
              : "默认城市";
} catch (error) {
    regionError = error instanceof Error ? error.message : "无法识别当前地区";
    discoveryError = "无法确定地区, 暂时不能加载精选活动";
    popularityError = "无法确定地区, 暂时不能加载活动榜单";
}

const homepageDivision =
    selectedDivision ??
    getRegionOptionByCode(defaultDivisionCode) ??
    getRegionOptionByCode(FALLBACK_DIVISION_CODE);
if (!homepageDivision) {
    throw new Error("Homepage fallback division is invalid");
}
const selectedDivisionCode = homepageDivision.code;

if (selectedDivision) {
    try {
        const db = await getDB(runtimeEnv);
        const [discoveryResult, popularityResult] = await Promise.allSettled([
            loadCachedHomepageDiscovery({
                origin: Astro.url,
                configuredScopes: runtimeEnv.PUBLIC_DATA_CACHE_SCOPES,
                divisionCode: selectedDivisionCode,
                load: async (asOfDate) =>
                    toPublicHomepageDiscovery(
                        await listHomepageDiscovery(db, selectedDivisionCode, asOfDate)
                    ),
                waitUntil
            }),
            loadCachedHomepagePopularity({
                origin: Astro.url,
                configuredScopes: runtimeEnv.PUBLIC_DATA_CACHE_SCOPES,
                divisionCode: selectedDivisionCode,
                window: trendWindow,
                load: async () =>
                    toPublicHomepagePopularity(
                        await listHomepagePopularity(db, selectedDivisionCode, trendWindow)
                    ),
                waitUntil
            })
        ]);

        if (discoveryResult.status === "fulfilled") {
            discovery = discoveryResult.value.value;
            cacheStates.push(discoveryResult.value.cacheState);
            if (discoveryResult.value.cacheState === "STALE-IF-ERROR") {
                cacheWarning = "数据暂时无法刷新, 当前显示最近缓存";
            }
        } else {
            discoveryError =
                discoveryResult.reason instanceof Error
                    ? discoveryResult.reason.message
                    : "无法加载精选活动";
        }

        if (popularityResult.status === "fulfilled") {
            popularity = popularityResult.value.value;
            cacheStates.push(popularityResult.value.cacheState);
            if (popularityResult.value.cacheState === "STALE-IF-ERROR") {
                cacheWarning = "数据暂时无法刷新, 当前显示最近缓存";
            }
        } else {
            popularityError =
                popularityResult.reason instanceof Error
                    ? popularityResult.reason.message
                    : "无法加载热门活动";
        }
    } catch (error) {
        const message = error instanceof Error ? error.message : "无法加载活动";
        discoveryError = message;
        popularityError = message;
    }
}

if (cacheStates.length > 0) {
    const headers = publicDataCacheResponseHeaders(combinePublicDataCacheStates(cacheStates));
    for (const [name, value] of Object.entries(headers)) Astro.response.headers.set(name, value);
}

const initialHomepage: PublicHomepageData = {
    division: {
        code: homepageDivision.code,
        name: homepageDivision.name,
        label: homepageDivision.label
    },
    ...discovery,
    popularity
};
---

<Layout
    title="ACG 活动目录"
    description="按地区和自然日期浏览附近 ACG 活动, 并查看近 3 日、7 日和 30 日热门活动"
>
    <NavLocationPicker
        slot="nav-control"
        selectedDivisionCode={selectedDivisionCode}
        initialTrend={trendWindow}
        shortLabel={homepageDivision.name}
        fullLabel={homepageDivision.label}
        {sourceLabel}
        client:load
    />

    {
        cacheWarning ? (
            <div
                class="mb-8 rounded-md bg-warning-subtle p-5 text-sm font-semibold text-warning"
                role="status"
            >
                {cacheWarning}
            </div>
        ) : null
    }

    <HomepageContent
        {initialHomepage}
        {regionError}
        {discoveryError}
        {popularityError}
        client:load
    />
</Layout>
