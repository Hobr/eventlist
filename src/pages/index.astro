---
import {
    ArrowRightOutline as ArrowRight,
    CalendarMonthOutline as CalendarClock,
    FireOutline as Flame,
    MapPinAltOutline as MapPinned
} from "flowbite-svelte-icons";
import CitySelector from "../components/CitySelector.svelte";
import EventArtwork from "../components/EventArtwork.astro";
import EventCard from "../components/EventCard.astro";
import PopularEventList from "../components/PopularEventList.astro";
import Layout from "../layouts/Layout.astro";
import { getDB } from "../lib/db";
import {
    listHomepageNearby,
    listHomepagePopularity,
    type HomepageNearby,
    type HomepagePopularity
} from "../lib/db/queries";
import { FALLBACK_DIVISION_CODE, type RegionOption } from "../lib/divisions";
import { formatEventSchedule, getChinaLocalDate } from "../lib/events/datetime";
import { getEventScaleLabel } from "../lib/events/options";
import { POPULARITY_WINDOWS, parsePopularityWindow } from "../lib/events/popularity";
import { resolveSelectedDivision } from "../lib/geo";
import { getRuntimeEnv } from "../lib/runtime/env";

export const prerender = false;

const runtimeEnv = getRuntimeEnv();
const defaultDivisionCode = runtimeEnv.DEFAULT_DIVISION_CODE || FALLBACK_DIVISION_CODE;
const trendWindow = parsePopularityWindow(Astro.url.searchParams.get("trend"));
const today = getChinaLocalDate();
let selectedDivision: RegionOption | null = null;
let sourceLabel = "默认城市";
let regionError = "";
let nearbyError = "";
let popularityError = "";
let nearby: HomepageNearby = { featured: null, ongoing: [], clusters: [] };
let popularity: HomepagePopularity = {
    window: trendWindow,
    local: [],
    nationwide: []
};

try {
    const resolved = await resolveSelectedDivision(
        Astro.request,
        Astro.url.searchParams,
        defaultDivisionCode
    );
    selectedDivision = resolved.division;
    sourceLabel =
        resolved.source === "query"
            ? "手动选择"
            : resolved.source === "cf"
              ? "IP 定位"
              : "默认城市";
} catch (error) {
    regionError = error instanceof Error ? error.message : "无法识别当前地区";
    nearbyError = "无法确定地区，暂时不能加载附近活动";
    popularityError = "无法确定地区，暂时不能加载本地热门活动";
}

const selectedDivisionCode = selectedDivision?.code ?? defaultDivisionCode;

if (selectedDivision) {
    try {
        const db = await getDB(runtimeEnv);
        const [nearbyResult, popularityResult] = await Promise.allSettled([
            listHomepageNearby(db, selectedDivisionCode),
            listHomepagePopularity(db, selectedDivisionCode, trendWindow)
        ]);

        if (nearbyResult.status === "fulfilled") {
            nearby = nearbyResult.value;
        } else {
            nearbyError =
                nearbyResult.reason instanceof Error
                    ? nearbyResult.reason.message
                    : "无法加载附近活动";
        }

        if (popularityResult.status === "fulfilled") {
            popularity = popularityResult.value;
        } else {
            popularityError =
                popularityResult.reason instanceof Error
                    ? popularityResult.reason.message
                    : "无法加载热门活动";
        }
    } catch (error) {
        const message = error instanceof Error ? error.message : "无法加载活动";
        nearbyError = message;
        popularityError = message;
    }
}

const featuredId = nearby.featured?.id;
const dateClusters = nearby.clusters
    .map((cluster) => ({
        ...cluster,
        events: cluster.events.filter((event) => event.id !== featuredId).slice(0, 4)
    }))
    .filter((cluster) => cluster.events.length > 0);
const hasNearbyEvents =
    Boolean(nearby.featured) || nearby.ongoing.length > 0 || dateClusters.length > 0;
const hasSecondaryNearby = nearby.ongoing.length > 0 || dateClusters.length > 0;
const featuredReason = nearby.featured
    ? `未来 14 天内，${getEventScaleLabel(nearby.featured.scale)}`
    : "";

function eventsHref(params: Record<string, string> = {}) {
    const searchParams = new URLSearchParams({ city: selectedDivisionCode, ...params });
    return `/events?${searchParams.toString()}`;
}

function trendHref(window: 3 | 7 | 30) {
    const searchParams = new URLSearchParams({
        city: selectedDivisionCode,
        trend: String(window)
    });
    return `/?${searchParams.toString()}#popular`;
}

function formatClusterDate(value: string) {
    return new Intl.DateTimeFormat("zh-CN", {
        timeZone: "Asia/Shanghai",
        month: "long",
        day: "numeric",
        weekday: "short"
    }).format(new Date(`${value}T00:00:00+08:00`));
}
---

<Layout
    title="ACG 活动目录"
    description="按地区和自然日期浏览附近 ACG 活动，并查看近 3 日、7 日和 30 日热门活动。"
>
    <div class="flex flex-col">
        <section
            aria-labelledby="home-heading"
            data-reveal
            class="relative isolate overflow-hidden rounded-md bg-foreground text-white shadow-elevated ring-1 ring-black/10"
        >
            <EventArtwork
                src={nearby.featured?.cover_url}
                alt={nearby.featured ? `${nearby.featured.title} 封面` : "同频点活动封面"}
                loading="eager"
                fill
                class="rounded-none"
            />
            <div class="absolute inset-0 bg-black/60"></div>

            <div
                class="relative flex min-h-[31rem] flex-col justify-between gap-12 p-6 sm:min-h-[35rem] sm:p-10 lg:min-h-[38rem] lg:p-14"
            >
                <header class="max-w-3xl">
                    <p class="inline-flex items-center gap-2 text-sm font-semibold text-white/80">
                        <MapPinned class="size-4" aria-hidden="true" />
                        {selectedDivision?.label ?? "当前地区"}
                    </p>
                    <h1
                        id="home-heading"
                        class="mt-5 text-5xl leading-none font-black text-balance text-white sm:text-6xl lg:text-7xl"
                    >
                        同频点
                    </h1>
                    <p
                        class="mt-5 max-w-xl text-base leading-7 text-pretty text-white/82 sm:text-lg"
                    >
                        按地区和自然日期，发现附近正在发生的 ACG 活动。
                    </p>
                </header>

                {
                    nearby.featured ? (
                        <div class="max-w-3xl">
                            <p class="text-xs font-semibold text-white/68">
                                主推荐 · {featuredReason}
                            </p>
                            <h2 class="mt-2 text-2xl leading-tight font-bold text-balance text-white sm:text-3xl">
                                {nearby.featured.title}
                            </h2>
                            <p class="mt-3 font-mono text-sm text-white/78 tabular-nums">
                                {formatEventSchedule(nearby.featured)}
                            </p>
                            <a
                                href={`/events/${nearby.featured.id}`}
                                class="group mt-6 inline-flex h-12 items-center gap-3 rounded-full bg-white py-1 pr-1 pl-5 text-sm font-bold text-black transition-[transform,background-color] duration-300 ease-motion hover:bg-white/92 focus-visible:ring-2 focus-visible:ring-white/70 focus-visible:outline-none active:scale-[0.98]"
                            >
                                查看主推荐
                                <span class="flex size-10 items-center justify-center rounded-full bg-black text-white transition-transform duration-300 ease-motion group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:scale-105">
                                    <ArrowRight class="size-4" aria-hidden="true" />
                                </span>
                            </a>
                        </div>
                    ) : (
                        <div class="max-w-xl">
                            <h2 class="text-2xl font-bold text-white">这个地区还没有近期活动</h2>
                            <p class="mt-2 text-sm leading-6 text-white/75">
                                可以切换地区，或先浏览完整活动目录。
                            </p>
                            <a
                                href="/events"
                                class="group mt-6 inline-flex h-12 items-center gap-3 rounded-full bg-white py-1 pr-1 pl-5 text-sm font-bold text-black transition-transform duration-300 ease-motion focus-visible:ring-2 focus-visible:ring-white/70 focus-visible:outline-none active:scale-[0.98]"
                            >
                                浏览活动目录
                                <span class="flex size-10 items-center justify-center rounded-full bg-black text-white">
                                    <ArrowRight class="size-4" aria-hidden="true" />
                                </span>
                            </a>
                        </div>
                    )
                }
            </div>
        </section>

        <div data-reveal class="mt-4 rounded-md bg-border/55 p-1.5 ring-1 ring-border/70">
            <div
                class="grid gap-5 rounded-[5px] bg-surface p-4 shadow-[inset_0_1px_0_rgba(255,255,255,0.65)] sm:p-5 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end dark:shadow-[inset_0_1px_0_rgba(255,255,255,0.06)]"
            >
                <div class="min-w-0">
                    <CitySelector
                        selectedDivisionCode={selectedDivisionCode}
                        action={`/?trend=${trendWindow}`}
                        label="浏览地区"
                        client:load
                    />
                    <p class="mt-3 flex items-center gap-2 text-xs text-muted">
                        <MapPinned class="size-4" aria-hidden="true" />
                        当前地区来自{sourceLabel}
                    </p>
                </div>

                <nav class="flex flex-wrap gap-2" aria-label="首页活动区域">
                    <a
                        href="#nearby"
                        class="inline-flex h-10 items-center gap-2 rounded-full bg-surface-subtle px-4 text-sm font-semibold text-foreground transition-[transform,background-color,color] duration-300 ease-motion hover:text-primary focus-visible:ring-2 focus-visible:ring-ring/60 focus-visible:outline-none active:scale-[0.98]"
                    >
                        <CalendarClock class="size-4" aria-hidden="true" />
                        附近活动
                    </a>
                    <a
                        href="#popular"
                        class="inline-flex h-10 items-center gap-2 rounded-full bg-surface-subtle px-4 text-sm font-semibold text-foreground transition-[transform,background-color,color] duration-300 ease-motion hover:text-primary focus-visible:ring-2 focus-visible:ring-ring/60 focus-visible:outline-none active:scale-[0.98]"
                    >
                        <Flame class="size-4" aria-hidden="true" />
                        热门活动
                    </a>
                </nav>
            </div>
        </div>

        {
            regionError ? (
                <div
                    class="mt-8 rounded-md bg-danger-subtle p-5 text-sm font-semibold text-danger"
                    role="alert"
                >
                    {regionError}
                </div>
            ) : null
        }

        <section
            id="nearby"
            aria-labelledby="nearby-heading"
            data-reveal
            class="scroll-mt-28 py-20 sm:py-24"
        >
            <header
                class="flex flex-col gap-5 border-t border-border/80 pt-6 sm:flex-row sm:items-end sm:justify-between"
            >
                <div>
                    <p class="font-mono text-xs font-semibold text-primary tabular-nums">
                        01 / 附近
                    </p>
                    <h2
                        id="nearby-heading"
                        class="mt-3 text-3xl font-black text-foreground sm:text-4xl"
                    >
                        附近活动
                    </h2>
                    <p class="mt-1 text-sm text-muted-foreground">
                        {selectedDivision?.label ?? "当前地区"}，正在进行与最近开始日期
                    </p>
                </div>
                <a
                    href={eventsHref()}
                    class="group inline-flex w-fit items-center gap-2 text-sm font-bold text-link transition-colors duration-300 ease-motion hover:text-primary"
                >
                    查看完整目录
                    <span
                        class="flex size-8 items-center justify-center rounded-full bg-primary-subtle"
                    >
                        <ArrowRight
                            class="size-4 transition-transform duration-300 ease-motion group-hover:translate-x-0.5"
                            aria-hidden="true"
                        />
                    </span>
                </a>
            </header>

            {
                nearbyError ? (
                    <div
                        class="mt-5 rounded-md bg-danger-subtle p-5 text-sm font-semibold text-danger"
                        role="alert"
                    >
                        {nearbyError}
                    </div>
                ) : hasNearbyEvents ? (
                    <div class="mt-10 flex flex-col gap-12">
                        {nearby.ongoing.length > 0 ? (
                            <section aria-labelledby="ongoing-heading" class="min-w-0">
                                <div class="flex items-end justify-between gap-4 pb-3">
                                    <div>
                                        <h3
                                            id="ongoing-heading"
                                            class="text-xl font-black text-foreground"
                                        >
                                            正在进行
                                        </h3>
                                        <p class="mt-1 text-xs text-muted">跨日且尚未结束</p>
                                    </div>
                                    <a
                                        href={eventsHref({ active: today })}
                                        class="shrink-0 text-xs font-bold text-link"
                                    >
                                        查看全部
                                    </a>
                                </div>
                                <div class="border-t border-border/80">
                                    {nearby.ongoing.map((event) => (
                                        <EventCard event={event} variant="compact" />
                                    ))}
                                </div>
                            </section>
                        ) : null}

                        {dateClusters.length > 0 ? (
                            <div class="grid gap-x-12 gap-y-12 md:grid-cols-2">
                                {dateClusters.map((cluster, index) => (
                                    <section
                                        aria-labelledby={`cluster-${cluster.date}`}
                                        class:list={[
                                            "min-w-0 border-t border-border/80 pt-5",
                                            index % 2 === 1 ? "md:mt-10" : ""
                                        ]}
                                    >
                                        <div class="flex items-end justify-between gap-4 pb-2">
                                            <div class="min-w-0">
                                                <h3
                                                    id={`cluster-${cluster.date}`}
                                                    class="text-lg font-black text-foreground"
                                                >
                                                    {formatClusterDate(cluster.date)}
                                                </h3>
                                                <p class="mt-1 font-mono text-xs text-muted">
                                                    {cluster.date}
                                                </p>
                                            </div>
                                            <a
                                                href={eventsHref({ starts: cluster.date })}
                                                class="shrink-0 text-xs font-bold text-link"
                                            >
                                                全部 {cluster.total} 场
                                            </a>
                                        </div>
                                        {cluster.events.length > 0 ? (
                                            <div class="mt-1">
                                                {cluster.events.map((event) => (
                                                    <EventCard event={event} variant="compact" />
                                                ))}
                                            </div>
                                        ) : (
                                            <p class="border-t border-border py-6 text-sm text-muted-foreground">
                                                该日期的活动已作为主推荐展示。
                                            </p>
                                        )}
                                    </section>
                                ))}
                            </div>
                        ) : null}
                        {!hasSecondaryNearby && nearby.featured ? (
                            <p class="border-y border-border/80 py-8 text-sm text-muted-foreground">
                                当前近期活动已作为主推荐展示。
                            </p>
                        ) : null}
                    </div>
                ) : (
                    <div class="mt-6 border-y border-border py-10">
                        <h3 class="text-xl font-black text-foreground">这个地区还没有近期活动</h3>
                        <p class="mt-2 text-sm text-muted-foreground">
                            可以切换地区，或提交新的活动信息。
                        </p>
                        <div class="mt-5 flex flex-wrap gap-3">
                            <a
                                href="/events"
                                class="inline-flex h-10 items-center rounded-md bg-foreground px-4 text-sm font-bold whitespace-nowrap text-background"
                            >
                                查看全部地区
                            </a>
                            <a
                                href="/submit"
                                class="inline-flex h-10 items-center rounded-md border border-border-strong bg-surface px-4 text-sm font-bold whitespace-nowrap text-foreground"
                            >
                                提交活动
                            </a>
                        </div>
                    </div>
                )
            }
        </section>

        <section
            id="popular"
            aria-labelledby="popular-heading"
            data-reveal
            class="scroll-mt-28 pb-20 sm:pb-24"
        >
            <header
                class="flex flex-col gap-5 border-t border-border/80 pt-6 sm:flex-row sm:items-end sm:justify-between"
            >
                <div>
                    <p class="font-mono text-xs font-semibold text-primary tabular-nums">
                        02 / 热门
                    </p>
                    <h2
                        id="popular-heading"
                        class="mt-3 text-3xl font-black text-foreground sm:text-4xl"
                    >
                        热门活动
                    </h2>
                    <p class="mt-1 text-sm text-muted-foreground">按活动详情独立访客数排序</p>
                </div>
                <nav
                    class="grid h-10 w-full grid-cols-3 overflow-hidden rounded-full bg-surface-subtle p-1 sm:w-60"
                    aria-label="热度统计时间范围"
                >
                    {
                        POPULARITY_WINDOWS.map((window) => (
                            <a
                                href={trendHref(window)}
                                aria-current={trendWindow === window ? "page" : undefined}
                                class:list={[
                                    "inline-flex items-center justify-center rounded-full px-3 text-sm font-bold transition-[transform,background-color,color] duration-300 ease-motion active:scale-[0.98]",
                                    trendWindow === window
                                        ? "bg-primary text-primary-foreground"
                                        : "text-muted-foreground hover:text-foreground"
                                ]}
                            >
                                {window} 日
                            </a>
                        ))
                    }
                </nav>
            </header>

            {
                popularityError ? (
                    <div
                        class="mt-5 rounded-md bg-danger-subtle p-5 text-sm font-semibold text-danger"
                        role="alert"
                    >
                        {popularityError}
                    </div>
                ) : (
                    <div class="mt-10 grid gap-12 lg:grid-cols-2">
                        <PopularEventList
                            headingId="local-popular-heading"
                            title="本地热门"
                            scope={`${selectedDivision?.label ?? "当前地区"}，近 ${trendWindow} 日`}
                            events={popularity.local}
                        />
                        <PopularEventList
                            headingId="nationwide-popular-heading"
                            title="全国热门"
                            scope={`全国范围，近 ${trendWindow} 日`}
                            events={popularity.nationwide}
                        />
                    </div>
                )
            }
        </section>
    </div>
</Layout>
