---
import { ShapesOutline, ScaleBalancedOutline, TagOutline } from "flowbite-svelte-icons";
import { waitUntil } from "cloudflare:workers";
import Layout from "../layouts/Layout.astro";
import { publicDataCacheResponseHeaders } from "../lib/cache/public-data";
import { loadCachedPublicEventTaxonomy } from "../lib/cache/public-routes";
import { getDB } from "../lib/db";
import { listPublicEventTaxonomy, type PublicEventTaxonomy } from "../lib/db/public-taxonomy";
import {
    EVENT_SCALES,
    EVENT_TYPES,
    getEventScaleLabel,
    getEventTypeLabel
} from "../lib/events/options";
import { getRuntimeEnv } from "../lib/runtime/env";

export const prerender = false;

const runtimeEnv = getRuntimeEnv();
let taxonomy: PublicEventTaxonomy = { tags: [], types: [], scales: [] };
let errorMessage = "";
let cacheWarning = "";

try {
    const result = await loadCachedPublicEventTaxonomy({
        origin: Astro.url,
        configuredScopes: runtimeEnv.PUBLIC_DATA_CACHE_SCOPES,
        load: () => listPublicEventTaxonomy(getDB(runtimeEnv)),
        waitUntil
    });
    taxonomy = result.value;
    for (const [name, value] of Object.entries(publicDataCacheResponseHeaders(result.cacheState))) {
        Astro.response.headers.set(name, value);
    }
    if (result.cacheState === "STALE-IF-ERROR") {
        cacheWarning = "数据暂时无法刷新, 当前显示最近缓存";
    }
} catch {
    errorMessage = "分类暂时无法加载, 请稍后重试";
}

function facetHref(parameter: "tag" | "type" | "scale", name: string) {
    const searchParams = new URLSearchParams({ status: "all", [parameter]: name });
    return `/events?${searchParams.toString()}`;
}

const typeItems = taxonomy.types.map((item) => ({
    ...item,
    label: getEventTypeLabel(item.name)
}));
const scaleItems = taxonomy.scales.map((item) => ({
    ...item,
    label: getEventScaleLabel(item.name)
}));
const hasTaxonomy = taxonomy.tags.length + typeItems.length + scaleItems.length > 0;
const configuredTypeCount = EVENT_TYPES.length;
const configuredScaleCount = EVENT_SCALES.length;
---

<Layout title="分类浏览" description="按标签、活动类型和活动规模浏览已发布的 ACG 活动">
    <div class="flex flex-col gap-10" data-reveal>
        <header class="border-t border-border/80 pt-6">
            <p class="font-mono text-xs font-semibold text-primary tabular-nums">活动目录</p>
            <h1 class="mt-3 text-4xl font-black text-foreground sm:text-5xl">分类浏览</h1>
            <p class="mt-3 max-w-2xl text-sm leading-6 text-muted-foreground sm:text-base">
                从活动标签、类型和规模开始, 直接进入对应的活动列表
            </p>
        </header>

        {
            cacheWarning ? (
                <div
                    class="rounded-md bg-warning-subtle p-5 text-sm font-semibold text-warning"
                    role="status"
                >
                    {cacheWarning}
                </div>
            ) : null
        }

        {
            errorMessage ? (
                <div
                    class="rounded-md bg-danger-subtle p-5 text-sm font-semibold text-danger"
                    role="alert"
                >
                    {errorMessage}
                </div>
            ) : !hasTaxonomy ? (
                <section class="border-y border-border/80 py-16 text-center" aria-label="分类状态">
                    <h2 class="text-xl font-bold text-foreground">暂时没有可浏览的分类</h2>
                    <p class="mt-2 text-sm text-muted-foreground">
                        已发布活动出现后, 分类会自动显示在这里
                    </p>
                </section>
            ) : (
                <div class="grid gap-10 lg:grid-cols-3">
                    {taxonomy.tags.length > 0 ? (
                        <section aria-labelledby="tag-section-title">
                            <div class="flex items-center gap-3 border-b border-border/80 pb-4">
                                <span class="flex size-9 items-center justify-center rounded-full bg-primary-subtle text-primary">
                                    <TagOutline class="size-4" aria-hidden="true" />
                                </span>
                                <div>
                                    <h2
                                        id="tag-section-title"
                                        class="text-lg font-bold text-foreground"
                                    >
                                        标签
                                    </h2>
                                </div>
                            </div>
                            <div class="mt-4 grid gap-2">
                                {taxonomy.tags.map((item) => (
                                    <a
                                        href={facetHref("tag", item.name)}
                                        class="group flex min-h-12 items-center justify-between gap-3 rounded-md border border-border/80 bg-surface px-4 py-3 transition-[transform,background-color,border-color] duration-300 ease-motion hover:-translate-y-0.5 hover:border-primary/50 hover:bg-surface-subtle focus-visible:ring-2 focus-visible:ring-ring/60 focus-visible:outline-none"
                                    >
                                        <span class="min-w-0 truncate text-sm font-semibold text-foreground group-hover:text-primary">
                                            {item.name}
                                        </span>
                                        <span class="shrink-0 font-mono text-xs text-muted tabular-nums">
                                            {item.event_count} 场
                                        </span>
                                    </a>
                                ))}
                            </div>
                        </section>
                    ) : null}

                    {typeItems.length > 0 ? (
                        <section aria-labelledby="type-section-title">
                            <div class="flex items-center gap-3 border-b border-border/80 pb-4">
                                <span class="flex size-9 items-center justify-center rounded-full bg-primary-subtle text-primary">
                                    <ShapesOutline class="size-4" aria-hidden="true" />
                                </span>
                                <div>
                                    <h2
                                        id="type-section-title"
                                        class="text-lg font-bold text-foreground"
                                    >
                                        活动类型
                                    </h2>
                                </div>
                            </div>
                            <div class="mt-4 grid gap-2">
                                {typeItems.map((item) => (
                                    <a
                                        href={facetHref("type", item.name)}
                                        class="group flex min-h-12 items-center justify-between gap-3 rounded-md border border-border/80 bg-surface px-4 py-3 transition-[transform,background-color,border-color] duration-300 ease-motion hover:-translate-y-0.5 hover:border-primary/50 hover:bg-surface-subtle focus-visible:ring-2 focus-visible:ring-ring/60 focus-visible:outline-none"
                                    >
                                        <span class="min-w-0 text-sm font-semibold text-foreground group-hover:text-primary">
                                            {item.label}
                                        </span>
                                        <span class="shrink-0 font-mono text-xs text-muted tabular-nums">
                                            {item.event_count} 场
                                        </span>
                                    </a>
                                ))}
                            </div>
                        </section>
                    ) : null}

                    {scaleItems.length > 0 ? (
                        <section aria-labelledby="scale-section-title">
                            <div class="flex items-center gap-3 border-b border-border/80 pb-4">
                                <span class="flex size-9 items-center justify-center rounded-full bg-primary-subtle text-primary">
                                    <ScaleBalancedOutline class="size-4" aria-hidden="true" />
                                </span>
                                <div>
                                    <h2
                                        id="scale-section-title"
                                        class="text-lg font-bold text-foreground"
                                    >
                                        活动规模
                                    </h2>
                                </div>
                            </div>
                            <div class="mt-4 grid gap-2">
                                {scaleItems.map((item) => (
                                    <a
                                        href={facetHref("scale", item.name)}
                                        class="group flex min-h-12 items-center justify-between gap-3 rounded-md border border-border/80 bg-surface px-4 py-3 transition-[transform,background-color,border-color] duration-300 ease-motion hover:-translate-y-0.5 hover:border-primary/50 hover:bg-surface-subtle focus-visible:ring-2 focus-visible:ring-ring/60 focus-visible:outline-none"
                                    >
                                        <span class="min-w-0 text-sm font-semibold text-foreground group-hover:text-primary">
                                            {item.label}
                                        </span>
                                        <span class="shrink-0 font-mono text-xs text-muted tabular-nums">
                                            {item.event_count} 场
                                        </span>
                                    </a>
                                ))}
                            </div>
                        </section>
                    ) : null}
                </div>
            )
        }
    </div>
</Layout>
