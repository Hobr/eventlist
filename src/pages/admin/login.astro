---
import {
    ArrowLeftOutline as ArrowLeft,
    LockOutline as LockKeyhole,
    ShieldCheckOutline as ShieldCheck
} from "flowbite-svelte-icons";
import Alert from "../../components/ui/alert.svelte";
import Button from "../../components/ui/button.svelte";
import Card from "../../components/ui/card.svelte";
import Input from "../../components/ui/input.svelte";
import Label from "../../components/ui/label.svelte";
import "../../styles/app.css";
import { verifyTokenValue } from "../../lib/auth/token";
import { getAuthMode, getRuntimeEnv } from "../../lib/runtime/env";
import { SITE_NAME } from "../../lib/site";

export const prerender = false;

const runtimeEnv = getRuntimeEnv();
const authMode = getAuthMode(runtimeEnv);
let errorMessage = "";

if (Astro.request.method === "POST") {
    const formData = await Astro.request.formData();
    const token = formData.get("token");

    if (authMode !== "token") {
        errorMessage = "当前为 Cloudflare Access 模式, 请通过 Access 登录入口访问";
    } else if (typeof token !== "string" || !(await verifyTokenValue(token, runtimeEnv))) {
        errorMessage = "Token 无效";
    } else {
        const next = Astro.url.searchParams.get("next") ?? "/admin";
        Astro.cookies.set("admin_token", token, {
            path: "/",
            httpOnly: true,
            secure: Astro.url.protocol === "https:",
            sameSite: "strict",
            maxAge: 86400
        });
        return Astro.redirect(next.startsWith("/admin") ? next : "/admin");
    }
}
---

<!doctype html>
<html lang="zh-CN">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="color-scheme" content="light dark" />
        <meta name="description" content={`${SITE_NAME}管理后台登录`} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <title>管理员登录 - {SITE_NAME}</title>
    </head>
    <body class="min-h-[100dvh] bg-background text-foreground antialiased">
        <main
            class="mx-auto flex min-h-[100dvh] w-full max-w-md flex-col justify-center px-5 py-10"
        >
            <a
                href="/"
                class="mb-8 inline-flex w-fit items-center gap-2 text-sm font-semibold text-muted-foreground transition-[transform,color] duration-300 ease-motion hover:-translate-x-1 hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring/60 focus-visible:outline-none"
            >
                <ArrowLeft class="size-4" aria-hidden="true" />
                返回公开站点
            </a>

            <Card class="p-6 shadow-elevated sm:p-8">
                <div class="mb-7 flex items-center gap-3">
                    <span
                        class="inline-flex size-10 items-center justify-center rounded-md bg-foreground text-background"
                        aria-hidden="true"
                    >
                        {
                            authMode === "access" ? (
                                <ShieldCheck class="size-5" />
                            ) : (
                                <LockKeyhole class="size-5" />
                            )
                        }
                    </span>
                    <div>
                        <p class="text-xs font-semibold text-muted">{SITE_NAME}</p>
                        <h1 class="text-xl font-black text-foreground">管理后台</h1>
                    </div>
                </div>

                {
                    authMode === "access" ? (
                        <section aria-labelledby="access-heading">
                            <h2 id="access-heading" class="text-base font-bold text-foreground">
                                Cloudflare Access 已启用
                            </h2>
                            <p class="mt-2 text-sm leading-6 text-muted-foreground">
                                请从受保护的 Access 应用入口进入, 身份通过验证后, 后台会自动开放
                            </p>
                            <Alert tone="success" class="mt-5 px-4 py-3 font-semibold">
                                当前页面不需要本地 Token
                            </Alert>
                            {errorMessage ? (
                                <Alert tone="danger" class="mt-4 font-semibold">
                                    {errorMessage}
                                </Alert>
                            ) : null}
                        </section>
                    ) : (
                        <form class="flex flex-col gap-4" method="post">
                            <div>
                                <Label for="token">管理员 Token</Label>
                                <Input
                                    id="token"
                                    name="token"
                                    type="password"
                                    autocomplete="current-password"
                                    required
                                    autofocus
                                    class="mt-1.5 h-11"
                                />
                                <p class="mt-1.5 text-xs text-muted">
                                    Token 仅用于建立本机管理会话
                                </p>
                            </div>
                            {errorMessage ? (
                                <Alert tone="danger" class="px-3 py-2 font-semibold">
                                    {errorMessage}
                                </Alert>
                            ) : null}
                            <Button class="h-11 font-bold" type="submit">
                                登录后台
                            </Button>
                        </form>
                    )
                }
            </Card>

            <p class="mt-6 text-xs leading-5 text-muted">
                管理操作会写入审核记录, 请仅在可信设备上使用
            </p>
        </main>
    </body>
</html>
