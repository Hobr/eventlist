---
import ArrowLeft from "phosphor-svelte/lib/ArrowLeft";
import LockKeyhole from "phosphor-svelte/lib/LockKey";
import ShieldCheck from "phosphor-svelte/lib/ShieldCheck";
import Alert from "../../components/ui/alert.svelte";
import Button from "../../components/ui/button.svelte";
import Card from "../../components/ui/card.svelte";
import Input from "../../components/ui/input.svelte";
import Label from "../../components/ui/label.svelte";
import "../../styles/app.css";
import { verifyTokenValue } from "../../lib/auth/token";
import { getAuthMode, getRuntimeEnv } from "../../lib/runtime/env";
import { SITE_NAME } from "../../lib/site";

export const prerender = false;

const runtimeEnv = getRuntimeEnv();
const authMode = getAuthMode(runtimeEnv);
let errorMessage = "";

if (Astro.request.method === "POST") {
    const formData = await Astro.request.formData();
    const token = formData.get("token");

    if (authMode !== "token") {
        errorMessage = "当前为 Cloudflare Access 模式, 请通过 Access 登录入口访问";
    } else if (typeof token !== "string" || !(await verifyTokenValue(token, runtimeEnv))) {
        errorMessage = "Token 无效";
    } else {
        const next = Astro.url.searchParams.get("next") ?? "/admin";
        Astro.cookies.set("admin_token", token, {
            path: "/",
            httpOnly: true,
            secure: Astro.url.protocol === "https:",
            sameSite: "strict",
            maxAge: 86400
        });
        return Astro.redirect(next.startsWith("/admin") ? next : "/admin");
    }
}
---

<!doctype html>
<html lang="zh-CN">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="color-scheme" content="light dark" />
        <meta name="description" content={`${SITE_NAME}管理后台登录`} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <title>管理员登录 - {SITE_NAME}</title>
    </head>
    <body class="login-body">
        <main class="login-shell">
            <a href="/" class="login-back">
                <ArrowLeft size={16} aria-hidden="true" />
                返回公开站点
            </a>

            <Card class="login-card">
                <div class="login-heading">
                    <span class="login-icon" aria-hidden="true">
                        {
                            authMode === "access" ? (
                                <ShieldCheck size={20} />
                            ) : (
                                <LockKeyhole size={20} />
                            )
                        }
                    </span>
                    <div>
                        <p class="login-brand">{SITE_NAME}</p>
                        <h1>管理后台</h1>
                    </div>
                </div>

                {
                    authMode === "access" ? (
                        <section aria-labelledby="access-heading">
                            <h2 id="access-heading" class="login-section-title">
                                Cloudflare Access 已启用
                            </h2>
                            <p class="login-copy">
                                请从受保护的 Access 应用入口进入, 身份通过验证后, 后台会自动开放
                            </p>
                            <Alert tone="success" class="login-alert">
                                当前页面不需要本地 Token
                            </Alert>
                            {errorMessage ? (
                                <Alert tone="danger" class="login-alert">
                                    {errorMessage}
                                </Alert>
                            ) : null}
                        </section>
                    ) : (
                        <form class="login-form" method="post">
                            <div class="login-field">
                                <Label for="token">管理员 Token</Label>
                                <Input
                                    id="token"
                                    name="token"
                                    type="password"
                                    autocomplete="current-password"
                                    required
                                    autofocus
                                    class="login-input"
                                />
                                <p class="login-field-note">Token 仅用于建立本机管理会话</p>
                            </div>
                            {errorMessage ? (
                                <Alert tone="danger" class="login-form-alert">
                                    {errorMessage}
                                </Alert>
                            ) : null}
                            <Button class="login-submit" type="submit">
                                登录后台
                            </Button>
                        </form>
                    )
                }
            </Card>

            <p class="login-footnote">管理操作会写入审核记录, 请仅在可信设备上使用</p>
        </main>
    </body>
</html>
