---
import ArrowLeft from "phosphor-svelte/lib/ArrowLeft";
import BulkEventImport from "../../../components/admin/BulkEventImport.svelte";
import AdminLayout from "../../../layouts/AdminLayout.astro";

export const prerender = false;
---

<AdminLayout title="批量导入" description="从 CSV 预览、校验并一次发布多条活动">
    <div class="admin-return-row">
        <a href="/admin" class="admin-return-link">
            <ArrowLeft size={17} aria-hidden="true" />
            返回活动队列
        </a>
    </div>

    <BulkEventImport client:load />
</AdminLayout>
