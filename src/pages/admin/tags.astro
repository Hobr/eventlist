---
import TagMergeForm from "../../components/admin/TagMergeForm.svelte";
import Alert from "../../components/ui/alert.svelte";
import AdminLayout from "../../layouts/AdminLayout.astro";
import { listTags } from "../../lib/db/tags";
import { getDB } from "../../lib/db";
import { getRuntimeEnv } from "../../lib/runtime/env";

export const prerender = false;

let tags = [];
let errorMessage = "";

try {
    const db = await getDB(getRuntimeEnv());
    tags = await listTags(db);
} catch (error) {
    errorMessage = error instanceof Error ? error.message : "无法加载标签";
}

const tagOptions = tags.map((tag) => ({
    value: String(tag.id),
    label: `${tag.name} (${tag.event_count})`
}));
---

<AdminLayout title="标签归并" description="将重复标签合并到统一名称, 保持活动检索整洁">
    {
        errorMessage ? (
            <Alert tone="danger" class="admin-page-error">
                {errorMessage}
            </Alert>
        ) : (
            <div class="tag-admin-page">
                <section class="tag-merge-section" aria-labelledby="merge-heading">
                    <div class="tag-section-heading">
                        <h2 id="merge-heading">归并重复标签</h2>
                        <p>源标签会被移除, 关联活动将改用目标标签</p>
                    </div>
                    <TagMergeForm options={tagOptions} client:load />
                </section>

                <section aria-labelledby="tag-inventory-heading">
                    <div class="tag-section-heading">
                        <div>
                            <h2 id="tag-inventory-heading">标签目录</h2>
                            <p>当前共 {tags.length} 个规范标签</p>
                        </div>
                    </div>

                    {tags.length > 0 ? (
                        <div class="tag-inventory">
                            {tags.map((tag) => (
                                <div class="tag-inventory-row">
                                    <div class="tag-inventory-copy">
                                        <strong>{tag.name}</strong>
                                        <small>标签 #{tag.id}</small>
                                    </div>
                                    <span class="tag-event-count">{tag.event_count} 个活动</span>
                                </div>
                            ))}
                        </div>
                    ) : (
                        <div class="tag-empty">暂无标签</div>
                    )}
                </section>
            </div>
        )
    }
</AdminLayout>
