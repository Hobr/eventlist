---
import {
    ArrowLeftOutline as ArrowLeft,
    CalendarMonthOutline as CalendarDays
} from "flowbite-svelte-icons";
import EventArtwork from "../components/EventArtwork.astro";
import Layout from "../layouts/Layout.astro";

Astro.response.status = 404;
---

<Layout title="页面不存在" description="无法找到请求的页面。">
    <section
        class="relative isolate overflow-hidden rounded-md bg-foreground text-white shadow-elevated ring-1 ring-black/10"
        data-reveal
    >
        <EventArtwork src={null} alt="同频点活动封面" loading="eager" fill class="rounded-none" />
        <div class="absolute inset-0 bg-black/68"></div>
        <div
            class="relative flex min-h-[30rem] flex-col justify-end p-6 sm:min-h-[34rem] sm:p-10 lg:p-14"
        >
            <p class="font-mono text-sm font-semibold text-white/70 tabular-nums">404</p>
            <h1 class="mt-3 text-4xl font-black text-balance text-white sm:text-6xl">
                果咩纳塞, 页面不存在
            </h1>
            <p class="mt-4 max-w-xl text-base leading-7 text-white/78">
                活动可能不存在, 也有可能被下架了
            </p>
            <div class="mt-7 flex flex-wrap gap-3">
                <a
                    href="/"
                    class="inline-flex h-11 items-center gap-2 rounded-full bg-white px-5 text-sm font-bold text-black transition-transform duration-300 ease-motion active:scale-[0.98]"
                >
                    <ArrowLeft class="size-4" aria-hidden="true" />
                    返回首页
                </a>
                <a
                    href="/events"
                    class="inline-flex h-11 items-center gap-2 rounded-full bg-white/14 px-5 text-sm font-bold text-white ring-1 ring-white/24 transition-transform duration-300 ease-motion active:scale-[0.98]"
                >
                    <CalendarDays class="size-4" aria-hidden="true" />
                    浏览其他活动
                </a>
            </div>
        </div>
    </section>
</Layout>
