---
import ArrowLeft from "phosphor-svelte/lib/ArrowLeft";
import CalendarDays from "phosphor-svelte/lib/CalendarDots";
import EventArtwork from "../components/EventArtwork.astro";
import Button from "../components/ui/button.svelte";
import Layout from "../layouts/Layout.astro";
Astro.response.status = 404;
---

<Layout title="页面不存在" description="无法找到请求的页面">
    <section class="not-found" data-reveal>
        <EventArtwork src={null} alt="同频点活动封面" loading="eager" fill class="not-found-art" />
        <div class="not-found-shade"></div>
        <div class="not-found-copy">
            <p>404</p>
            <h1>果咩纳塞, 页面不存在</h1>
            <p>活动可能不存在, 也有可能被下架了</p>
            <div>
                <Button href="/" size="lg"
                    ><ArrowLeft size={17} aria-hidden="true" />返回首页</Button
                >
                <Button href="/events" variant="outline" size="lg"
                    ><CalendarDays size={17} aria-hidden="true" />浏览活动</Button
                >
            </div>
        </div>
    </section>
</Layout>
