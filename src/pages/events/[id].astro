---
import {
    ArrowLeftOutline as ArrowLeft,
    ArrowUpRightFromSquareOutline as ExternalLink,
    CalendarMonthOutline as CalendarDays,
    MapPinOutline as MapPin,
    StoreOutline as Store,
    TicketOutline as Ticket
} from "flowbite-svelte-icons";
import EventArtwork from "../../components/EventArtwork.astro";
import Badge from "../../components/ui/badge.svelte";
import Layout from "../../layouts/Layout.astro";
import { getDB, STATUS } from "../../lib/db";
import { getPublicEvent } from "../../lib/db/queries";
import { getDivisionLabel } from "../../lib/divisions";
import { formatEventSchedule } from "../../lib/events/datetime";
import { getEventScaleLabel, getEventTypeLabel } from "../../lib/events/options";
import { getRuntimeEnv } from "../../lib/runtime/env";
import { buildEventJsonLd } from "../../lib/seo";

export const prerender = false;

const rawId = Astro.params.id ?? "";
const id = /^[1-9]\d*$/.test(rawId) ? Number(rawId) : Number.NaN;
let event = null;
let errorMessage = "";

try {
    if (!Number.isSafeInteger(id)) throw new Error("活动不存在");

    const db = await getDB(getRuntimeEnv());
    event = await getPublicEvent(db, id);
    if (!event) {
        Astro.response.status = 404;
        errorMessage = "活动不存在或尚未公开";
    }
} catch (error) {
    Astro.response.status = 404;
    errorMessage = error instanceof Error ? error.message : "活动不存在";
}

const tags = event?.tags ? event.tags.split("、").filter(Boolean) : [];
const divisionLabel = event ? getDivisionLabel(event.division_code) : null;
const canonicalUrl = new URL(Astro.url.pathname, Astro.url.origin).toString();
const jsonLd = event ? buildEventJsonLd(event, canonicalUrl) : undefined;
---

<Layout
    title={event?.title ?? "活动不存在"}
    description={event?.description ?? "活动不存在或尚未公开。"}
    jsonLd={jsonLd}
>
    {
        !event ? (
            <div class="border-y border-border/80 py-16 text-center" data-reveal>
                <h1 class="text-2xl font-black text-foreground">{errorMessage}</h1>
                <a
                    href="/events"
                    class="mt-6 inline-flex h-10 items-center gap-2 rounded-full bg-foreground px-5 text-sm font-bold text-background transition-transform duration-300 ease-motion active:scale-[0.98]"
                >
                    <ArrowLeft class="size-4" aria-hidden="true" />
                    返回活动列表
                </a>
            </div>
        ) : (
            <article
                class="flex flex-col gap-10"
                data-reveal
                data-event-view-endpoint={
                    event.status === STATUS.PUBLISHED ? `/api/events/${event.id}/view` : undefined
                }
            >
                <a
                    href="/events"
                    class="inline-flex w-fit items-center gap-2 text-sm font-semibold text-muted-foreground transition-[transform,color] duration-300 ease-motion hover:-translate-x-1 hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring/60 focus-visible:outline-none"
                >
                    <ArrowLeft class="size-4" aria-hidden="true" />
                    活动列表
                </a>

                {event.status === STATUS.OFFLINE ? (
                    <div class="rounded-md bg-warning-subtle px-4 py-3 text-sm font-semibold text-warning">
                        该活动已下线，页面仅作为历史信息保留。
                    </div>
                ) : null}

                <header class="relative min-h-[25rem] overflow-hidden rounded-md shadow-elevated ring-1 ring-black/10 sm:min-h-[34rem]">
                    <EventArtwork
                        src={event.cover_url}
                        alt={`${event.title} 封面`}
                        loading="eager"
                        fill
                        class="rounded-none"
                    />
                    <div class="absolute inset-0 bg-black/55" aria-hidden="true" />
                    <div class="absolute inset-x-0 bottom-0 p-5 text-white sm:p-8 lg:p-10">
                        <div class="flex flex-wrap gap-1.5">
                            <Badge tone="primary" class="border-white/15 bg-primary text-white">
                                {getEventTypeLabel(event.type)}
                            </Badge>
                            <Badge class="border-white/20 bg-black/35 text-white">
                                {getEventScaleLabel(event.scale)}
                            </Badge>
                        </div>
                        <h1 class="mt-4 max-w-4xl text-3xl leading-tight font-black text-balance sm:text-5xl">
                            {event.title}
                        </h1>
                        {tags.length > 0 ? (
                            <div class="mt-5 flex flex-wrap gap-2">
                                {tags.map((tag) => (
                                    <a
                                        href={`/events?tag=${encodeURIComponent(tag)}`}
                                        class="rounded-sm bg-black/45 px-2.5 py-1 text-xs font-semibold text-white transition-colors duration-300 ease-motion hover:bg-white/18"
                                    >
                                        # {tag}
                                    </a>
                                ))}
                            </div>
                        ) : null}
                    </div>
                </header>

                <section
                    class="grid overflow-hidden rounded-md bg-surface ring-1 ring-border/80 sm:grid-cols-3"
                    aria-label="活动信息"
                >
                    <div class="flex gap-3 border-b border-border/75 p-5 sm:border-r sm:border-b-0">
                        <CalendarDays class="size-5 shrink-0 text-primary" aria-hidden="true" />
                        <div>
                            <p class="text-xs font-semibold text-muted">日期</p>
                            <strong class="mt-1 block text-sm text-foreground">
                                {formatEventSchedule(event)}
                            </strong>
                        </div>
                    </div>
                    <div class="flex gap-3 border-b border-border/75 p-5 sm:border-r sm:border-b-0">
                        <MapPin class="size-5 shrink-0 text-accent" aria-hidden="true" />
                        <div>
                            <p class="text-xs font-semibold text-muted">地区</p>
                            <strong class="mt-1 block text-sm text-foreground">
                                {divisionLabel ?? "未知地区"}
                            </strong>
                        </div>
                    </div>
                    <div class="flex gap-3 p-5">
                        <Store class="size-5 shrink-0 text-warning" aria-hidden="true" />
                        <div>
                            <p class="text-xs font-semibold text-muted">场地</p>
                            <strong class="mt-1 block text-sm text-foreground">
                                {event.venue}
                            </strong>
                        </div>
                    </div>
                </section>

                <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_21rem]">
                    <section aria-labelledby="event-description-heading">
                        <h2
                            id="event-description-heading"
                            class="text-xl font-black text-foreground"
                        >
                            活动介绍
                        </h2>
                        {event.description ? (
                            <p class="mt-5 max-w-[68ch] text-base leading-8 text-pretty whitespace-pre-line text-foreground">
                                {event.description}
                            </p>
                        ) : (
                            <p class="mt-4 text-sm text-muted">暂无活动介绍。</p>
                        )}
                    </section>

                    <aside class="flex h-fit flex-col gap-4 border-t border-border/80 pt-7 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-8">
                        <h2 class="text-base font-black text-foreground">参加活动</h2>
                        {event.ticket_url ? (
                            <a
                                href={event.ticket_url}
                                target="_blank"
                                rel="nofollow noopener noreferrer"
                                class="group inline-flex h-12 items-center justify-between gap-3 rounded-full bg-primary py-1 pr-1 pl-5 text-sm font-bold text-primary-foreground transition-transform duration-300 ease-motion active:scale-[0.98]"
                            >
                                查看购票页
                                <span class="flex size-10 items-center justify-center rounded-full bg-white/18">
                                    <Ticket
                                        class="size-4 transition-transform duration-300 ease-motion group-hover:scale-105"
                                        aria-hidden="true"
                                    />
                                </span>
                            </a>
                        ) : null}
                        <a
                            href={event.source_url}
                            target="_blank"
                            rel="nofollow noopener noreferrer"
                            class="group inline-flex h-12 items-center justify-between gap-3 rounded-full bg-surface-subtle py-1 pr-1 pl-5 text-sm font-bold text-foreground transition-transform duration-300 ease-motion active:scale-[0.98]"
                        >
                            活动来源
                            <span class="flex size-10 items-center justify-center rounded-full bg-surface">
                                <ExternalLink
                                    class="size-4 transition-transform duration-300 ease-motion group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                                    aria-hidden="true"
                                />
                            </span>
                        </a>
                        <dl class="mt-2 flex flex-col gap-4 border-t border-border pt-5 text-sm">
                            <div>
                                <dt class="text-xs font-semibold text-muted">详细地址</dt>
                                <dd class="mt-1 text-foreground">{event.address ?? "未填写"}</dd>
                            </div>
                            <div>
                                <dt class="text-xs font-semibold text-muted">官方交流群</dt>
                                <dd class="mt-1 text-foreground">{event.qq_group ?? "未填写"}</dd>
                            </div>
                        </dl>
                    </aside>
                </div>
            </article>
        )
    }
</Layout>

<script>
    const viewTarget = document.querySelector<HTMLElement>("[data-event-view-endpoint]");
    const endpoint = viewTarget?.dataset.eventViewEndpoint;

    if (endpoint) {
        void fetch(endpoint, {
            method: "POST",
            credentials: "same-origin",
            keepalive: true
        }).catch(() => undefined);
    }
</script>
