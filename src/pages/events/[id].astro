---
import { waitUntil } from "cloudflare:workers";
import {
    ArrowLeftOutline as ArrowLeft,
    ArrowUpRightFromSquareOutline as ExternalLink,
    CalendarMonthOutline as CalendarDays,
    ClockOutline as Clock,
    FireOutline as Fire,
    MapPinOutline as MapPin,
    RefreshOutline as Refresh,
    StoreOutline as Store,
    TicketOutline as Ticket
} from "flowbite-svelte-icons";
import EventArtwork from "../../components/EventArtwork.astro";
import Alert from "../../components/ui/alert.svelte";
import Badge from "../../components/ui/badge.svelte";
import Button from "../../components/ui/button.svelte";
import Layout from "../../layouts/Layout.astro";
import { publicDataCacheResponseHeaders } from "../../lib/cache/public-data";
import { loadCachedPublicEventDetail } from "../../lib/cache/public-routes";
import { getDB, STATUS } from "../../lib/db";
import { getPublicEvent } from "../../lib/db/public-events";
import { getPublicEventRecentVisitorCount } from "../../lib/db/views";
import { getDivisionLabel } from "../../lib/divisions";
import {
    formatSqliteUpdatedAt,
    getEventDetailOptionalContent,
    getEventUserStatus
} from "../../lib/events/detail";
import { formatEventSchedule } from "../../lib/events/datetime";
import { getEventScaleLabel, getEventTypeLabel } from "../../lib/events/options";
import { getRuntimeEnv } from "../../lib/runtime/env";
import { buildEventJsonLd } from "../../lib/seo";

export const prerender = false;

const rawId = Astro.params.id ?? "";
const id = /^[1-9]\d*$/.test(rawId) ? Number(rawId) : Number.NaN;
let event = null;
let recentVisitorCount = 0;
let errorMessage = "";
let cacheWarning = "";

try {
    if (!Number.isSafeInteger(id)) throw new Error("活动不存在");

    const runtimeEnv = getRuntimeEnv();
    const db = await getDB(runtimeEnv);
    const [eventLoad, visitorCountLoad] = await Promise.allSettled([
        loadCachedPublicEventDetail({
            origin: Astro.url,
            configuredScopes: runtimeEnv.PUBLIC_DATA_CACHE_SCOPES,
            eventId: id,
            load: () => getPublicEvent(db, id),
            waitUntil
        }),
        getPublicEventRecentVisitorCount(db, id)
    ]);
    if (eventLoad.status === "rejected") throw eventLoad.reason;

    const eventResult = eventLoad.value;
    event = eventResult.value;
    if (visitorCountLoad.status === "fulfilled") {
        recentVisitorCount = visitorCountLoad.value;
    } else if (event) {
        cacheWarning = "活动热度暂时无法加载, 其他信息仍可正常查看";
    } else {
        throw visitorCountLoad.reason;
    }
    const headers = publicDataCacheResponseHeaders(eventResult.cacheState);
    for (const [name, value] of Object.entries(headers)) Astro.response.headers.set(name, value);
    if (eventResult.cacheState === "STALE-IF-ERROR") {
        cacheWarning = "数据暂时无法刷新, 当前显示最近缓存";
    }
    if (!event) {
        Astro.response.status = 404;
        errorMessage = "活动不存在或尚未公开";
    }
} catch (error) {
    Astro.response.status = 404;
    errorMessage = error instanceof Error ? error.message : "活动不存在";
}

const tags = event?.tags ? event.tags.split("、").filter(Boolean) : [];
const divisionLabel = event ? getDivisionLabel(event.division_code) : null;
const canonicalUrl = new URL(Astro.url.pathname, Astro.url.origin).toString();
const jsonLd = event ? buildEventJsonLd(event, canonicalUrl) : undefined;
const {
    description,
    address,
    qqGroup,
    ticketUrl,
    sourceUrl,
    organizer,
    admissionMethodLabel,
    priceRange,
    admissionStart,
    hasAction,
    hasDetailFacts,
    hasAsideContent,
    hasOptionalContent
} = getEventDetailOptionalContent(event ?? {});
const eventStatus = event ? getEventUserStatus(event) : null;
const updatedAt = event ? formatSqliteUpdatedAt(event.updated_at) : null;
---

<Layout
    title={event?.title ?? "活动不存在"}
    description={event ? (description ?? undefined) : "活动不存在或尚未公开"}
    jsonLd={jsonLd}
>
    {
        !event ? (
            <Alert tone="danger" class="p-8 text-center" data-reveal>
                <h1 class="text-2xl font-black text-foreground">{errorMessage}</h1>
                <Button
                    href="/events"
                    class="mt-6 rounded-full bg-foreground px-5 font-bold text-background hover:bg-foreground/90 dark:bg-foreground! dark:text-background! dark:hover:bg-foreground/90!"
                >
                    <ArrowLeft class="size-4" aria-hidden="true" />
                    返回活动列表
                </Button>
            </Alert>
        ) : (
            <article
                class="flex flex-col gap-10"
                data-reveal
                data-event-view-endpoint={
                    event.status === STATUS.PUBLISHED ? `/api/events/${event.id}/view` : undefined
                }
            >
                <a
                    href="/events"
                    class="inline-flex w-fit items-center gap-2 text-sm font-semibold text-muted-foreground transition-[transform,color] duration-300 ease-motion hover:-translate-x-1 hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring/60 focus-visible:outline-none"
                >
                    <ArrowLeft class="size-4" aria-hidden="true" />
                    活动列表
                </a>

                {cacheWarning ? (
                    <Alert tone="warning" class="px-4 py-3 font-semibold" role="status">
                        {cacheWarning}
                    </Alert>
                ) : null}

                {event.status === STATUS.OFFLINE ? (
                    <Alert tone="warning" class="px-4 py-3 font-semibold" role="status">
                        该活动已下线, 页面仅作为历史信息保留
                    </Alert>
                ) : null}

                <header class="relative min-h-[25rem] overflow-hidden rounded-md shadow-elevated ring-1 ring-black/10 sm:min-h-[34rem]">
                    <EventArtwork
                        src={event.cover_url}
                        alt={`${event.title} 封面`}
                        loading="eager"
                        fill
                        class="rounded-none"
                    />
                    <div class="absolute inset-0 bg-black/55" aria-hidden="true" />
                    <div class="absolute inset-x-0 bottom-0 p-5 text-white sm:p-8 lg:p-10">
                        <div class="flex flex-wrap gap-1.5">
                            <Badge tone="primary" class="border-white/15 bg-primary text-white">
                                {getEventTypeLabel(event.type)}
                            </Badge>
                            <Badge class="border-white/20 bg-black/35 text-white">
                                {getEventScaleLabel(event.scale)}
                            </Badge>
                        </div>
                        <h1 class="mt-4 max-w-4xl text-3xl leading-tight font-black text-balance sm:text-5xl">
                            {event.title}
                        </h1>
                        {tags.length > 0 ? (
                            <div class="mt-5 flex flex-wrap gap-2">
                                {tags.map((tag) => (
                                    <a
                                        href={`/events?tag=${encodeURIComponent(tag)}`}
                                        class="rounded-sm bg-black/45 px-2.5 py-1 text-xs font-semibold text-white transition-colors duration-300 ease-motion hover:bg-white/18"
                                    >
                                        # {tag}
                                    </a>
                                ))}
                            </div>
                        ) : null}
                    </div>
                </header>

                <section
                    class="grid overflow-hidden rounded-md bg-surface ring-1 ring-border/80 sm:grid-cols-3"
                    aria-label="活动信息"
                >
                    <div class="flex gap-3 border-b border-border/75 p-5 sm:border-r sm:border-b-0">
                        <CalendarDays class="size-5 shrink-0 text-primary" aria-hidden="true" />
                        <div>
                            <p class="text-xs font-semibold text-muted">日期</p>
                            <strong class="mt-1 block text-sm text-foreground">
                                {formatEventSchedule(event)}
                            </strong>
                        </div>
                    </div>
                    <div class="flex gap-3 border-b border-border/75 p-5 sm:border-r sm:border-b-0">
                        <MapPin class="size-5 shrink-0 text-accent" aria-hidden="true" />
                        <div>
                            <p class="text-xs font-semibold text-muted">地区</p>
                            <strong class="mt-1 block text-sm text-foreground">
                                {divisionLabel ?? "未知地区"}
                            </strong>
                        </div>
                    </div>
                    <div class="flex gap-3 p-5">
                        <Store class="size-5 shrink-0 text-warning" aria-hidden="true" />
                        <div>
                            <p class="text-xs font-semibold text-muted">场地</p>
                            <strong class="mt-1 block text-sm text-foreground">
                                {event.venue}
                            </strong>
                        </div>
                    </div>
                </section>

                <section
                    class="grid overflow-hidden rounded-md bg-surface ring-1 ring-border/80 sm:grid-cols-3"
                    aria-label="活动当前信息"
                >
                    <div class="flex gap-3 border-b border-border/75 p-5 sm:border-r sm:border-b-0">
                        <Clock class="size-5 shrink-0 text-primary" aria-hidden="true" />
                        <div>
                            <p class="text-xs font-semibold text-muted">当前状态</p>
                            <strong class="mt-1 block text-sm text-foreground">
                                {eventStatus}
                            </strong>
                        </div>
                    </div>
                    <div class="flex gap-3 border-b border-border/75 p-5 sm:border-r sm:border-b-0">
                        <Refresh class="size-5 shrink-0 text-accent" aria-hidden="true" />
                        <div>
                            <p class="text-xs font-semibold text-muted">最后更新时间</p>
                            <strong class="mt-1 block text-sm text-foreground">{updatedAt}</strong>
                        </div>
                    </div>
                    <div class="flex gap-3 p-5">
                        <Fire class="size-5 shrink-0 text-warning" aria-hidden="true" />
                        <div>
                            <p class="text-xs font-semibold text-muted">近 30 日热度</p>
                            <strong class="mt-1 block text-sm text-foreground tabular-nums">
                                {recentVisitorCount}
                            </strong>
                        </div>
                    </div>
                </section>

                {hasOptionalContent ? (
                    <div
                        class:list={[
                            "gap-12",
                            hasAsideContent
                                ? "grid lg:grid-cols-[minmax(0,1fr)_21rem]"
                                : "flex flex-col"
                        ]}
                    >
                        {description ? (
                            <section aria-labelledby="event-description-heading">
                                <h2
                                    id="event-description-heading"
                                    class="text-xl font-black text-foreground"
                                >
                                    活动介绍
                                </h2>
                                <p class="mt-5 max-w-[68ch] text-base leading-8 text-pretty whitespace-pre-line text-foreground">
                                    {description}
                                </p>
                            </section>
                        ) : null}

                        {hasAsideContent ? (
                            <aside
                                class:list={[
                                    "flex h-fit flex-col gap-4",
                                    description
                                        ? "border-t border-border/80 pt-7 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-8"
                                        : "max-w-[21rem] lg:col-start-2"
                                ]}
                            >
                                {hasAction ? (
                                    <h2 class="text-base font-black text-foreground">参加活动</h2>
                                ) : null}
                                {ticketUrl ? (
                                    <Button
                                        href={ticketUrl}
                                        target="_blank"
                                        rel="nofollow noopener noreferrer"
                                        size="lg"
                                        class="group h-12 w-full justify-between rounded-full py-1 pr-1 pl-5 text-sm font-bold"
                                    >
                                        购票/预约入口
                                        <span class="flex size-10 items-center justify-center rounded-full bg-white/18">
                                            <Ticket
                                                class="size-4 transition-transform duration-300 ease-motion group-hover:scale-105"
                                                aria-hidden="true"
                                            />
                                        </span>
                                    </Button>
                                ) : null}
                                {sourceUrl ? (
                                    <Button
                                        href={sourceUrl}
                                        target="_blank"
                                        rel="nofollow noopener noreferrer"
                                        variant="tonal"
                                        size="lg"
                                        class="group h-12 w-full justify-between rounded-full bg-surface-subtle py-1 pr-1 pl-5 text-sm font-bold text-foreground hover:bg-surface-subtle/80 dark:bg-surface-subtle! dark:text-foreground! dark:hover:bg-surface-subtle/80!"
                                    >
                                        活动来源
                                        <span class="flex size-10 items-center justify-center rounded-full bg-surface">
                                            <ExternalLink
                                                class="size-4 transition-transform duration-300 ease-motion group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                                                aria-hidden="true"
                                            />
                                        </span>
                                    </Button>
                                ) : null}
                                {hasDetailFacts ? (
                                    <dl
                                        class:list={[
                                            "flex flex-col gap-4 text-sm",
                                            hasAction ? "mt-2 border-t border-border pt-5" : ""
                                        ]}
                                    >
                                        {address ? (
                                            <div>
                                                <dt class="text-xs font-semibold text-muted">
                                                    详细地址
                                                </dt>
                                                <dd class="mt-1 text-foreground">{address}</dd>
                                            </div>
                                        ) : null}
                                        {qqGroup ? (
                                            <div>
                                                <dt class="text-xs font-semibold text-muted">
                                                    官方交流群
                                                </dt>
                                                <dd class="mt-1 text-foreground">{qqGroup}</dd>
                                            </div>
                                        ) : null}
                                        {organizer ? (
                                            <div>
                                                <dt class="text-xs font-semibold text-muted">
                                                    主办方
                                                </dt>
                                                <dd class="mt-1 break-words text-foreground">
                                                    {organizer}
                                                </dd>
                                            </div>
                                        ) : null}
                                        {admissionMethodLabel ? (
                                            <div>
                                                <dt class="text-xs font-semibold text-muted">
                                                    入场方式
                                                </dt>
                                                <dd class="mt-1 text-foreground">
                                                    {admissionMethodLabel}
                                                </dd>
                                            </div>
                                        ) : null}
                                        {priceRange ? (
                                            <div>
                                                <dt class="text-xs font-semibold text-muted">
                                                    票价区间
                                                </dt>
                                                <dd class="mt-1 [overflow-wrap:anywhere] break-words text-foreground">
                                                    {priceRange}
                                                </dd>
                                            </div>
                                        ) : null}
                                        {admissionStart ? (
                                            <div>
                                                <dt class="text-xs font-semibold text-muted">
                                                    开始购票/预约/申请
                                                </dt>
                                                <dd class="mt-1 text-foreground">
                                                    {admissionStart}
                                                </dd>
                                            </div>
                                        ) : null}
                                    </dl>
                                ) : null}
                            </aside>
                        ) : null}
                    </div>
                ) : null}
            </article>
        )
    }
</Layout>

<script>
    const viewTarget = document.querySelector<HTMLElement>("[data-event-view-endpoint]");
    const endpoint = viewTarget?.dataset.eventViewEndpoint;

    if (endpoint) {
        void fetch(endpoint, {
            method: "POST",
            credentials: "same-origin",
            keepalive: true
        }).catch(() => undefined);
    }
</script>
