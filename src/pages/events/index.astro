---
import { waitUntil } from "cloudflare:workers";
import {
    ChevronLeftOutline as ChevronLeft,
    ChevronRightOutline as ChevronRight
} from "flowbite-svelte-icons";
import FilterBar from "../../components/FilterBar.svelte";
import EventCard from "../../components/EventCard.astro";
import Layout from "../../layouts/Layout.astro";
import {
    combinePublicDataCacheStates,
    publicDataCacheResponseHeaders
} from "../../lib/cache/public-data";
import { loadCachedPublicEventList, loadCachedPublicTags } from "../../lib/cache/public-routes";
import { getDB } from "../../lib/db";
import {
    listPublishedEvents,
    type EventSort,
    type EventTiming,
    type PublishedEventFilters
} from "../../lib/db/public-events";
import { topTags } from "../../lib/db/tags";
import { isRegionCode } from "../../lib/divisions";
import { isCanonicalDate } from "../../lib/events/datetime";
import { EVENT_SCALES, EVENT_TYPES } from "../../lib/events/options";
import { getRuntimeEnv } from "../../lib/runtime/env";

export const prerender = false;

function parsePositiveInt(value: string | null) {
    const numberValue = Number.parseInt(value ?? "", 10);
    return Number.isInteger(numberValue) && numberValue > 0 ? numberValue : undefined;
}

function parseDivisionCode(value: string | null) {
    return value && isRegionCode(value) ? value : undefined;
}

function parseDate(value: string | null) {
    return value && isCanonicalDate(value) ? value : undefined;
}

function parseTag(value: string | null) {
    const normalized = value?.trim();
    return normalized || undefined;
}

function parseTiming(value: string | null): EventTiming {
    return value === "ended" || value === "all" ? value : "upcoming";
}

function parseSort(value: string | null): EventSort | undefined {
    return value === "start_asc" || value === "start_desc" || value === "end_desc"
        ? value
        : undefined;
}

function nextHref(page: number) {
    const searchParams = new URLSearchParams(Astro.url.searchParams);
    searchParams.set("page", String(page));
    const query = searchParams.toString();
    return query ? `/events?${query}` : "/events";
}

const filters: PublishedEventFilters = {
    timing: parseTiming(Astro.url.searchParams.get("status")),
    divisionCode: parseDivisionCode(Astro.url.searchParams.get("city")),
    type: Astro.url.searchParams.get("type") || undefined,
    scale: Astro.url.searchParams.get("scale") || undefined,
    tag: parseTag(Astro.url.searchParams.get("tag")),
    from: parseDate(Astro.url.searchParams.get("from")),
    to: parseDate(Astro.url.searchParams.get("to")),
    starts: parseDate(Astro.url.searchParams.get("starts")),
    active: parseDate(Astro.url.searchParams.get("active")),
    page: parsePositiveInt(Astro.url.searchParams.get("page")) ?? 1,
    pageSize: 20,
    sort: parseSort(Astro.url.searchParams.get("sort"))
};

const timingCopy = {
    upcoming: {
        description: "筛选近期已发布且未结束的 ACG 活动",
        kicker: "已发布 · 未结束",
        emptyTitle: "没有匹配的近期活动"
    },
    ended: {
        description: "查询已发布且已经结束的 ACG 活动",
        kicker: "已发布 · 已结束",
        emptyTitle: "没有匹配的已结束活动"
    },
    all: {
        description: "查询全部已发布的 ACG 活动",
        kicker: "已发布 · 全部",
        emptyTitle: "没有匹配的活动"
    }
}[filters.timing ?? "upcoming"];

const types = EVENT_TYPES;
const scales = EVENT_SCALES;
const runtimeEnv = getRuntimeEnv();
let tags = [];
let events = [];
let hasNext = false;
let errorMessage = "";
let cacheWarning = "";

try {
    const db = await getDB(runtimeEnv);
    const [tagResult, pageResult] = await Promise.all([
        loadCachedPublicTags({
            origin: Astro.url,
            configuredScopes: runtimeEnv.PUBLIC_DATA_CACHE_SCOPES,
            query: "",
            limit: 20,
            load: () => topTags(db, 20),
            waitUntil
        }),
        loadCachedPublicEventList({
            origin: Astro.url,
            configuredScopes: runtimeEnv.PUBLIC_DATA_CACHE_SCOPES,
            filters,
            load: (asOfDate) => listPublishedEvents(db, filters, asOfDate),
            waitUntil
        })
    ]);

    tags = tagResult.value;
    events = pageResult.value.events;
    hasNext = pageResult.value.hasNext;
    const cacheState = combinePublicDataCacheStates([tagResult.cacheState, pageResult.cacheState]);
    const headers = publicDataCacheResponseHeaders(cacheState);
    for (const [name, value] of Object.entries(headers)) Astro.response.headers.set(name, value);
    if (cacheState === "STALE-IF-ERROR") {
        cacheWarning = "数据暂时无法刷新, 当前显示最近缓存";
    }
} catch (error) {
    errorMessage = error instanceof Error ? error.message : "无法加载活动列表";
}
---

<Layout title="活动列表" description={timingCopy.description}>
    <div class="flex flex-col gap-10" data-reveal>
        <header
            class="flex flex-col gap-5 border-t border-border/80 pt-6 sm:flex-row sm:items-end sm:justify-between"
        >
            <div>
                <p class="font-mono text-xs font-semibold text-primary tabular-nums">
                    {timingCopy.kicker}
                </p>
                <h1 class="mt-3 text-4xl font-black text-foreground sm:text-5xl">活动列表</h1>
                <p class="mt-3 max-w-2xl text-sm leading-6 text-muted-foreground">
                    {timingCopy.description}
                </p>
            </div>
            <div class="flex items-center gap-3">
                <strong class="font-mono text-3xl font-black text-foreground tabular-nums">
                    {String(events.length).padStart(2, "0")}
                </strong>
                <span class="max-w-20 text-xs leading-tight text-muted">本页活动</span>
            </div>
        </header>

        <FilterBar types={types} scales={scales} tags={tags} filters={filters} client:load />

        {
            cacheWarning ? (
                <div
                    class="rounded-md bg-warning-subtle p-5 text-sm font-semibold text-warning"
                    role="status"
                >
                    {cacheWarning}
                </div>
            ) : null
        }

        {
            errorMessage ? (
                <div
                    class="rounded-md bg-danger-subtle p-5 text-sm font-semibold text-danger"
                    role="alert"
                >
                    {errorMessage}
                </div>
            ) : events.length > 0 ? (
                <>
                    <section aria-label="活动结果" class="border-t border-border/80">
                        {events.map((event, index) => (
                            <EventCard event={event} variant="row" priority={index < 3} />
                        ))}
                    </section>
                    <nav
                        class="flex items-center justify-center gap-3 py-4 text-sm text-muted"
                        aria-label="活动分页"
                    >
                        {filters.page && filters.page > 1 ? (
                            <a
                                class="inline-flex h-9 items-center gap-1.5 rounded-full bg-surface-subtle px-4 text-xs font-semibold text-foreground transition-[transform,background-color,color] duration-300 ease-motion hover:text-primary active:scale-[0.98]"
                                href={nextHref(filters.page - 1)}
                            >
                                <ChevronLeft class="size-4" aria-hidden="true" />
                                上一页
                            </a>
                        ) : null}
                        <span class="font-medium text-muted-foreground">第 {filters.page} 页</span>
                        {hasNext ? (
                            <a
                                class="inline-flex h-9 items-center gap-1.5 rounded-full bg-surface-subtle px-4 text-xs font-semibold text-foreground transition-[transform,background-color,color] duration-300 ease-motion hover:text-primary active:scale-[0.98]"
                                href={nextHref((filters.page ?? 1) + 1)}
                            >
                                下一页
                                <ChevronRight class="size-4" aria-hidden="true" />
                            </a>
                        ) : null}
                    </nav>
                </>
            ) : (
                <div class="border-y border-border/80 py-16 text-center">
                    <h2 class="text-xl font-bold text-foreground">{timingCopy.emptyTitle}</h2>
                    <p class="mt-2 text-sm text-muted-foreground">尝试移除部分筛选条件</p>
                    <a
                        href="/events"
                        class="mt-6 inline-flex h-10 items-center rounded-full bg-foreground px-5 text-sm font-bold text-background transition-transform duration-300 ease-motion active:scale-[0.98]"
                    >
                        重置筛选
                    </a>
                </div>
            )
        }
    </div>
</Layout>
