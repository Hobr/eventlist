---
import CalendarDays from "phosphor-svelte/lib/CalendarDots";
import Compass from "phosphor-svelte/lib/Compass";
import GitFork from "phosphor-svelte/lib/GitFork";
import Send from "phosphor-svelte/lib/PaperPlaneTilt";
import Tags from "phosphor-svelte/lib/Tag";
import PublicMobileNav from "../components/PublicMobileNav.svelte";
import { SITE_NAME, SITE_SLOGAN } from "../lib/site";
import "../styles/app.css";

interface Props {
    title?: string;
    description?: string;
    jsonLd?: Record<string, unknown>;
}

const { title = SITE_NAME, description = SITE_SLOGAN, jsonLd } = Astro.props;
const currentPath = Astro.url.pathname;
const siteTitle = title === SITE_NAME ? title : `${title} - ${SITE_NAME}`;
const hasNavControl = Astro.slots.has("nav-control");

function isCurrent(href: string) {
    if (href === "/") return currentPath === "/";
    return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<!doctype html>
<html lang="zh-CN">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="color-scheme" content="light dark" />
        <meta name="description" content={description} />
        <meta property="og:title" content={siteTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta name="generator" content={Astro.generator} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <title>{siteTitle}</title>
        {jsonLd ? <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} /> : null}
        <script is:inline>
            document.documentElement.classList.add("reveal-ready");
        </script>
    </head>
    <body class="site-body">
        <a href="#main-content" class="skip-link"> 跳至主要内容 </a>

        <div class="site-frame">
            <header class="site-nav-shell">
                <div class="site-nav">
                    <a href="/" class="site-brand">
                        <span>
                            <strong>{SITE_NAME}</strong>
                            <small>{SITE_SLOGAN}</small>
                        </span>
                    </a>

                    <nav class="site-nav-links" aria-label="主导航">
                        <a
                            href="/"
                            aria-current={isCurrent("/") ? "page" : undefined}
                            class="site-nav-link"
                        >
                            <Compass size={16} aria-hidden="true" />
                            首页
                        </a>
                        <a
                            href="/events"
                            aria-current={isCurrent("/events") ? "page" : undefined}
                            class="site-nav-link"
                        >
                            <CalendarDays size={16} aria-hidden="true" />
                            活动
                        </a>
                        <a
                            href="/categories"
                            aria-current={isCurrent("/categories") ? "page" : undefined}
                            class="site-nav-link"
                        >
                            <Tags size={16} aria-hidden="true" />
                            分类
                        </a>
                        <a
                            href="/submit"
                            aria-current={isCurrent("/submit") ? "page" : undefined}
                            class="site-nav-link"
                        >
                            <Send size={16} aria-hidden="true" />
                            投稿
                        </a>
                    </nav>

                    <div class="site-nav-actions">
                        {
                            hasNavControl ? (
                                <div class="site-nav-control">
                                    <slot name="nav-control" />
                                </div>
                            ) : null
                        }

                        <div class="site-mobile-nav">
                            <PublicMobileNav {currentPath} client:load />
                        </div>
                    </div>
                </div>
            </header>

            <main id="main-content" class="site-main">
                <slot />
            </main>

            <footer class="site-footer">
                <div class="site-footer-inner">
                    <div>
                        <strong>{SITE_NAME}</strong>
                    </div>
                    <div>
                        <a
                            href="https://github.com/Hobr/eventlist"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="site-footer-link"
                            aria-label="在 GitHub 上查看项目并参与开发"
                        >
                            <GitFork size={15} aria-hidden="true" />
                            <span>GitHub.com/Hobr/eventlist</span>
                        </a>
                    </div>
                </div>
            </footer>
        </div>

        <script>
            const revealSelector = "[data-reveal]";
            const revealItem = (item: Element) => item.setAttribute("data-revealed", "true");
            const intersectionObserver =
                "IntersectionObserver" in window
                    ? new IntersectionObserver(
                          (entries) => {
                              for (const entry of entries) {
                                  if (!entry.isIntersecting) continue;
                                  revealItem(entry.target);
                                  intersectionObserver?.unobserve(entry.target);
                              }
                          },
                          { rootMargin: "0px 0px -8%", threshold: 0.12 }
                      )
                    : null;

            function registerRevealItem(item: Element) {
                if (!item.isConnected || item.getAttribute("data-revealed") === "true") return;
                if (intersectionObserver) {
                    intersectionObserver.observe(item);
                } else {
                    revealItem(item);
                }
            }

            function registerRevealTree(root: ParentNode) {
                if (root instanceof Element && root.matches(revealSelector)) {
                    registerRevealItem(root);
                }
                root.querySelectorAll<Element>(revealSelector).forEach(registerRevealItem);
            }

            registerRevealTree(document);

            if ("MutationObserver" in window) {
                const mutationObserver = new MutationObserver((records) => {
                    for (const record of records) {
                        for (const node of record.addedNodes) {
                            if (node instanceof Element) registerRevealTree(node);
                        }
                    }
                });
                mutationObserver.observe(document.body, { childList: true, subtree: true });
            }
        </script>
    </body>
</html>
