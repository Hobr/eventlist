---
import ArrowUpRight from "phosphor-svelte/lib/ArrowUpRight";
import AdminNavList from "../components/admin/AdminNavList.svelte";
import AdminMobileNav from "../components/admin/AdminMobileNav.svelte";
import { SITE_NAME } from "../lib/site";
import "../styles/app.css";

interface Props {
    title: string;
    description?: string;
}
const { title, description = undefined } = Astro.props;
const currentPath = Astro.url.pathname;
const adminLabel =
    Astro.locals.admin?.email ??
    (Astro.locals.admin?.mode === "access" ? "Access 管理员" : "Token 管理员");
const metaDescription = description ?? `${title} · ${SITE_NAME}管理后台`;
const pageTitle = `${title} - ${SITE_NAME}管理后台`;
---

<!doctype html>
<html lang="zh-CN">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="color-scheme" content="light dark" />
        <meta name="description" content={metaDescription} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <title>{pageTitle}</title>
    </head>
    <body class="admin-body admin-density">
        <a href="#admin-main" class="skip-link">跳至主要内容</a>
        <header class="admin-shell">
            <div class="admin-brand-row">
                <a href="/admin" class="admin-brand">
                    <span aria-hidden="true">同</span>
                    <strong>{SITE_NAME}<small>管理工作台</small></strong>
                </a>
                <div class="admin-mobile">
                    <AdminMobileNav {currentPath} {title} {adminLabel} client:load />
                </div>
                <div class="admin-identity">
                    <span>{adminLabel}</span>
                    <a href="/">公开站点 <ArrowUpRight size={15} aria-hidden="true" /></a>
                </div>
            </div>
            <nav class="admin-route-nav" aria-label="管理后台导航">
                <AdminNavList {currentPath} />
            </nav>
        </header>
        <div class="admin-page-heading">
            <h1>{title}</h1>
            {description ? <p>{description}</p> : null}
        </div>
        <main id="admin-main" class="admin-main"><slot /></main>
    </body>
</html>
