---
import { Image } from "astro:assets";
import { getDisplayCoverUrl } from "../lib/events/cover";

interface Props {
    src?: string | null;
    alt: string;
    loading?: "eager" | "lazy";
    fill?: boolean;
    class?: string;
}

const {
    src,
    alt,
    loading = "lazy",
    fill = false,
    class: className = "event-artwork-wide"
} = Astro.props;
const coverUrl = getDisplayCoverUrl(src);
const fallbackUrl = "/images/event-fallback.webp";
---

<div
    class:list={["event-artwork", fill ? "event-artwork-fill" : "event-artwork-static", className]}
    role="img"
    aria-label={alt}
>
    <Image
        src={fallbackUrl}
        alt=""
        width={1200}
        height={675}
        loading={loading}
        decoding="async"
        class="event-artwork-image"
    />
    {
        coverUrl ? (
            <Image
                src={coverUrl}
                alt=""
                width={1200}
                height={675}
                loading={loading}
                decoding="async"
                fetchpriority={loading === "eager" ? "high" : "auto"}
                referrerpolicy="no-referrer"
                class="event-artwork-image"
                onerror="this.remove()"
            />
        ) : null
    }
</div>
