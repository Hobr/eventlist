---
import {
    ArrowUpRightFromSquareOutline as ArrowUpRight,
    CalendarMonthOutline as CalendarDays,
    MapPinOutline as MapPin
} from "flowbite-svelte-icons";
import type { PublicEventRow } from "../lib/db/public-events";
import { getDivisionLabel } from "../lib/divisions";
import { formatEventSchedule } from "../lib/events/datetime";
import { getEventScaleLabel, getEventTypeLabel } from "../lib/events/options";
import { toPublicEventRow } from "../lib/public/homepage";
import Badge from "./ui/badge.svelte";
import EventArtwork from "./EventArtwork.astro";
import EventRow from "./EventRow.svelte";

interface Props {
    event: PublicEventRow;
    variant?: "card" | "row" | "featured" | "compact";
    priority?: boolean;
}

const { event, variant = "card", priority = false } = Astro.props;
const divisionLabel = getDivisionLabel(event.division_code) ?? "未知地区";
const typeLabel = getEventTypeLabel(event.type);
const scaleLabel = getEventScaleLabel(event.scale);
const startLabel = `${event.start_date.slice(5).replace("-", "/")}${event.start_time ? ` ${event.start_time}` : ""}`;
const endLabel = `${event.end_date.slice(5).replace("-", "/")}${event.end_time ? ` ${event.end_time}` : ""}`;
const dateLabel = formatEventSchedule(event);
const href = `/events/${event.id}`;
---

{
    variant === "featured" ? (
        <a
            href={href}
            class="group grid min-w-0 overflow-hidden rounded-md bg-surface shadow-elevated ring-1 ring-border/80 transition-transform duration-300 ease-motion focus-visible:ring-2 focus-visible:ring-ring/70 focus-visible:outline-none active:scale-[0.995] md:grid-cols-[minmax(13rem,0.82fr)_minmax(0,1.18fr)]"
        >
            <EventArtwork
                src={event.cover_url}
                alt={`${event.title} 封面`}
                loading={priority ? "eager" : "lazy"}
                class="aspect-[16/9] h-full min-h-44 w-full rounded-none transition-transform duration-700 ease-motion group-hover:scale-[1.025] md:aspect-auto md:min-h-56"
            />
            <div class="flex min-w-0 flex-col justify-center p-5 sm:p-6">
                <p class="text-xs font-bold text-primary sm:text-sm">
                    {typeLabel} / {scaleLabel}
                </p>
                <h2 class="mt-3 text-2xl leading-tight font-black text-foreground sm:text-3xl">
                    {event.title}
                </h2>
                <div class="mt-4 flex flex-col gap-2 text-sm text-muted-foreground">
                    <span class="inline-flex items-center gap-2">
                        <CalendarDays class="size-4" aria-hidden="true" />
                        {dateLabel}
                    </span>
                    <span class="inline-flex items-center gap-2">
                        <MapPin class="size-4" aria-hidden="true" />
                        <span>{divisionLabel}</span>
                        <span class="text-muted">{event.venue}</span>
                    </span>
                </div>
                <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-link">
                    查看活动
                    <span class="flex size-8 items-center justify-center rounded-full bg-primary-subtle">
                        <ArrowUpRight
                            class="size-4 transition-transform duration-300 ease-motion group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:scale-105"
                            aria-hidden="true"
                        />
                    </span>
                </span>
            </div>
        </a>
    ) : variant === "compact" ? (
        <a
            href={href}
            class="group grid grid-cols-[7.5rem_minmax(0,1fr)_auto] items-center gap-3 border-b border-border/75 py-4 transition-[transform,background-color,color] duration-300 ease-motion hover:translate-x-1 hover:text-primary focus-visible:ring-2 focus-visible:ring-ring/60 focus-visible:outline-none active:scale-[0.995]"
        >
            <div class="flex min-w-0 flex-col font-mono">
                <strong class="text-sm leading-tight font-black whitespace-nowrap text-primary">
                    {startLabel}
                </strong>
                <span class="mt-1 text-xs whitespace-nowrap text-muted">至 {endLabel}</span>
            </div>
            <div class="min-w-0">
                <h3 class="truncate text-sm font-bold text-foreground transition-colors duration-300 ease-motion group-hover:text-primary sm:text-base">
                    {event.title}
                </h3>
                <p class="mt-1 truncate text-xs text-muted-foreground sm:text-sm">
                    {divisionLabel} · {event.venue}
                </p>
            </div>
            <ArrowUpRight
                class="size-4 text-muted transition-transform duration-300 ease-motion group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:scale-105"
                aria-hidden="true"
            />
        </a>
    ) : variant === "row" ? (
        <EventRow event={toPublicEventRow(event)} {priority} />
    ) : (
        <a
            href={href}
            class="group flex flex-col overflow-hidden rounded-md bg-surface shadow-elevated ring-1 ring-border/80 transition-transform duration-300 ease-motion hover:-translate-y-1 focus-visible:ring-2 focus-visible:ring-ring/60 focus-visible:outline-none active:scale-[0.995]"
        >
            <EventArtwork
                src={event.cover_url}
                alt={`${event.title} 封面`}
                class="aspect-[4/3] rounded-none"
            />
            <div class="flex flex-1 flex-col p-4">
                <div class="flex flex-wrap gap-1.5">
                    <Badge tone="primary">{typeLabel}</Badge>
                    <Badge>{scaleLabel}</Badge>
                </div>
                <h3 class="mt-3 text-base leading-tight font-bold text-foreground">
                    {event.title}
                </h3>
                <p class="mt-3 text-sm text-muted-foreground">{dateLabel}</p>
                <p class="mt-1 text-xs text-muted">
                    {divisionLabel} · {event.venue}
                </p>
            </div>
        </a>
    )
}
