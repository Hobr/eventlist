---
import Button from "../ui/button.svelte";

interface Props {
    page: number;
    hasNext: boolean;
}
const { page, hasNext } = Astro.props;

function hrefFor(nextPage: number) {
    const url = new URL(Astro.url);
    url.searchParams.set("page", String(nextPage));
    return `${url.pathname}${url.search}`;
}
---

<nav class="pagination" aria-label="分页">
    {
        page > 1 ? (
            <Button href={hrefFor(page - 1)} rel="prev" variant="outline">
                上一页
            </Button>
        ) : null
    }
    <span>第 {page} 页</span>
    {
        hasNext ? (
            <Button href={hrefFor(page + 1)} rel="next" variant="outline">
                下一页
            </Button>
        ) : null
    }
</nav>
