---
import { PaginationItem } from "flowbite-svelte";

interface Props {
    page: number;
    hasNext: boolean;
}

const { page, hasNext } = Astro.props;

function hrefFor(nextPage: number) {
    const url = new URL(Astro.url);
    url.searchParams.set("page", String(nextPage));
    return `${url.pathname}${url.search}`;
}
---

<nav class="flex items-center justify-center gap-3 py-4 text-sm text-muted" aria-label="分页">
    {
        page > 1 ? (
            <PaginationItem
                href={hrefFor(page - 1)}
                rel="prev"
                class="rounded-md border-border-strong bg-surface text-muted-foreground hover:bg-surface-subtle hover:text-foreground dark:border-border-strong! dark:bg-surface! dark:text-muted-foreground! dark:hover:bg-surface-subtle! dark:hover:text-foreground!"
            >
                上一页
            </PaginationItem>
        ) : null
    }
    <span class="font-medium text-muted-foreground">第 {page} 页</span>
    {
        hasNext ? (
            <PaginationItem
                href={hrefFor(page + 1)}
                rel="next"
                class="rounded-md border-border-strong bg-surface text-muted-foreground hover:bg-surface-subtle hover:text-foreground dark:border-border-strong! dark:bg-surface! dark:text-muted-foreground! dark:hover:bg-surface-subtle! dark:hover:text-foreground!"
            >
                下一页
            </PaginationItem>
        ) : null
    }
</nav>
