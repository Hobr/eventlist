---
import { FloppyDiskOutline as Save } from "flowbite-svelte-icons";
import DivisionPicker from "../DivisionPicker.svelte";
import SelectField from "../SelectField.svelte";
import TagInput from "../TagInput.svelte";
import type { EventRecord } from "../../lib/db/admin-events";
import type { TagSummary } from "../../lib/db/tags";
import {
    EVENT_ADMISSION_METHODS,
    EVENT_SCALES,
    EVENT_SCHEDULE_STATUSES,
    EVENT_TYPES
} from "../../lib/events/options";

interface Props {
    eventRecord?: EventRecord | null;
    canonicalTags: TagSummary[];
    formId: string;
    cancelHref: string;
    submitButtonId: string;
    statusId: string;
    submitLabel: string;
    statusText: string;
    defaultDivisionCode?: string;
    showRequiredIndicators?: boolean;
}

const {
    eventRecord = null,
    canonicalTags,
    formId,
    cancelHref,
    submitButtonId,
    statusId,
    submitLabel,
    statusText,
    defaultDivisionCode = "",
    showRequiredIndicators = false
} = Astro.props;

const typeOptions = EVENT_TYPES.map((type) => ({ value: type.name, label: type.label }));
const scaleOptions = EVENT_SCALES.map((scale) => ({ value: scale.name, label: scale.label }));
const scheduleStatusOptions = EVENT_SCHEDULE_STATUSES.map((status) => ({
    value: status.name,
    label: status.label
}));
const admissionMethodOptions = EVENT_ADMISSION_METHODS.map((method) => ({
    value: method.name,
    label: method.label
}));
const headingId = (name: string) => `${formId}-${name}-heading`;
const value = (name: keyof EventRecord) => {
    const current = eventRecord?.[name];
    return typeof current === "string" ? current : "";
};
const fieldCls =
    "flex h-10 w-full rounded-md border border-border-strong bg-surface px-3 py-2 text-sm text-foreground transition-[border-color,background-color,box-shadow] duration-300 ease-motion placeholder:text-muted focus-visible:border-ring focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/40";
const labelCls = "text-sm font-semibold text-muted-foreground";
---

<form
    id={formId}
    data-event-id={eventRecord?.id}
    data-return-href={cancelHref}
    class="flex flex-col gap-9"
>
    <section
        class="grid gap-4 border-b border-border/80 pb-8 sm:grid-cols-2"
        aria-labelledby={headingId("identity")}
    >
        <div class="sm:col-span-2">
            <h2 id={headingId("identity")} class="text-base font-black text-foreground">
                活动识别
            </h2>
            <p class="mt-1 text-sm text-muted-foreground">用清晰、可检索的名称与分类描述活动</p>
        </div>
        <div class="sm:col-span-2">
            <label class={labelCls} for="title">
                活动名称
                {
                    showRequiredIndicators ? (
                        <span class="ml-1 text-xs font-semibold text-danger">必填</span>
                    ) : null
                }
            </label>
            <input
                id="title"
                name="title"
                required
                value={value("title")}
                class={`mt-1.5 ${fieldCls}`}
            />
        </div>
        <SelectField
            name="type"
            label="类型"
            value={value("type")}
            options={typeOptions}
            required
            showRequiredIndicator={showRequiredIndicators}
            client:load
        />
        <SelectField
            name="scale"
            label="规模"
            value={value("scale")}
            options={scaleOptions}
            required
            showRequiredIndicator={showRequiredIndicators}
            client:load
        />
    </section>

    <section
        class="grid gap-4 border-b border-border/80 pb-8 sm:grid-cols-2"
        aria-labelledby={headingId("schedule")}
    >
        <div class="sm:col-span-2">
            <h2 id={headingId("schedule")} class="text-base font-black text-foreground">
                时间与地点
            </h2>
        </div>
        <div class="sm:col-span-2">
            <DivisionPicker
                name="division_code"
                value={eventRecord?.division_code ?? defaultDivisionCode}
                label="地区"
                mode="county"
                required
                showRequiredIndicator={showRequiredIndicators}
                wide
                client:load
            />
        </div>
        <div>
            <label class={labelCls} for="venue">
                场馆
                {
                    showRequiredIndicators ? (
                        <span class="ml-1 text-xs font-semibold text-danger">必填</span>
                    ) : null
                }
            </label>
            <input
                id="venue"
                name="venue"
                required
                value={value("venue")}
                class={`mt-1.5 ${fieldCls}`}
            />
        </div>
        <div>
            <label class={labelCls} for="address">详细地址</label>
            <input
                id="address"
                name="address"
                value={value("address")}
                class={`mt-1.5 ${fieldCls}`}
            />
        </div>
        <div>
            <label class={labelCls} for="start_date">
                开始日期
                {
                    showRequiredIndicators ? (
                        <span class="ml-1 text-xs font-semibold text-danger">必填</span>
                    ) : null
                }
            </label>
            <input
                id="start_date"
                name="start_date"
                type="date"
                required
                value={value("start_date")}
                class={`mt-1.5 ${fieldCls}`}
            />
        </div>
        <div>
            <label class={labelCls} for="end_date">
                结束日期
                {
                    showRequiredIndicators ? (
                        <span class="ml-1 text-xs font-semibold text-danger">必填</span>
                    ) : null
                }
            </label>
            <input
                id="end_date"
                name="end_date"
                type="date"
                required
                value={value("end_date")}
                class={`mt-1.5 ${fieldCls}`}
            />
        </div>
        <div>
            <label class={labelCls} for="start_time">开始时间（选填）</label>
            <input
                id="start_time"
                name="start_time"
                type="time"
                value={value("start_time")}
                class={`mt-1.5 ${fieldCls}`}
            />
        </div>
        <div>
            <label class={labelCls} for="end_time">结束时间（选填）</label>
            <input
                id="end_time"
                name="end_time"
                type="time"
                value={value("end_time")}
                class={`mt-1.5 ${fieldCls}`}
            />
        </div>
    </section>

    <section
        class="grid gap-4 border-b border-border/80 pb-8 sm:grid-cols-2"
        aria-labelledby={headingId("links")}
    >
        <div class="sm:col-span-2">
            <h2 id={headingId("links")} class="text-base font-black text-foreground">
                来源与参与信息
            </h2>
        </div>
        <div class="sm:col-span-2">
            <label class={labelCls} for="source_url">
                来源链接
                {
                    showRequiredIndicators ? (
                        <span class="ml-1 text-xs font-semibold text-danger">必填</span>
                    ) : null
                }
            </label>
            <input
                id="source_url"
                name="source_url"
                type="url"
                required
                value={value("source_url")}
                class={`mt-1.5 ${fieldCls}`}
            />
        </div>
        <div class="sm:col-span-2">
            <label class={labelCls} for="organizer">主办方</label>
            <input
                id="organizer"
                name="organizer"
                maxlength="200"
                value={value("organizer")}
                class={`mt-1.5 ${fieldCls}`}
            />
        </div>
        <SelectField
            name="schedule_status"
            label="活动异常状态"
            value={value("schedule_status")}
            options={scheduleStatusOptions}
            placeholder="正常"
            client:load
        />
        <SelectField
            name="admission_method"
            label="入场方式"
            value={value("admission_method")}
            options={admissionMethodOptions}
            placeholder="选择入场方式"
            client:load
        />
        <div class="sm:col-span-2">
            <label class={labelCls} for="price_range">票价区间</label>
            <input
                id="price_range"
                name="price_range"
                maxlength="120"
                value={value("price_range")}
                class={`mt-1.5 ${fieldCls}`}
            />
        </div>
        <div>
            <label class={labelCls} for="admission_start_date">开始购票/预约/申请日期</label>
            <input
                id="admission_start_date"
                name="admission_start_date"
                type="date"
                value={value("admission_start_date")}
                class={`mt-1.5 ${fieldCls}`}
            />
        </div>
        <div>
            <label class={labelCls} for="admission_start_time">开始购票/预约/申请时间</label>
            <input
                id="admission_start_time"
                name="admission_start_time"
                type="time"
                value={value("admission_start_time")}
                class={`mt-1.5 ${fieldCls}`}
            />
        </div>
        <div>
            <label class={labelCls} for="submitter_contact">
                投稿联系方式
                {
                    showRequiredIndicators ? (
                        <span class="ml-1 text-xs font-semibold text-danger">必填</span>
                    ) : null
                }
            </label>
            <input
                id="submitter_contact"
                name="submitter_contact"
                required
                value={value("submitter_contact")}
                class={`mt-1.5 ${fieldCls}`}
            />
        </div>
        <div>
            <label class={labelCls} for="ticket_url">购票地址</label>
            <input
                id="ticket_url"
                name="ticket_url"
                type="url"
                value={value("ticket_url")}
                class={`mt-1.5 ${fieldCls}`}
            />
        </div>
        <div>
            <label class={labelCls} for="qq_group">官方交流群</label>
            <input
                id="qq_group"
                name="qq_group"
                value={value("qq_group")}
                class={`mt-1.5 ${fieldCls}`}
            />
        </div>
        <div>
            <label class={labelCls} for="cover_url">封面 URL</label>
            <input
                id="cover_url"
                name="cover_url"
                type="url"
                pattern="https://.*"
                value={value("cover_url")}
                class={`mt-1.5 ${fieldCls}`}
            />
        </div>
    </section>

    <section class="grid gap-4" aria-labelledby={headingId("content")}>
        <div>
            <h2 id={headingId("content")} class="text-base font-black text-foreground">公开内容</h2>
        </div>
        {
            eventRecord?.tag_suggestions ? (
                <div class="rounded-md bg-surface-subtle p-4 ring-1 ring-border/70">
                    <p class="text-xs font-semibold text-muted">投稿标签建议</p>
                    <p class="mt-1.5 text-sm whitespace-pre-wrap text-foreground">
                        {eventRecord.tag_suggestions}
                    </p>
                </div>
            ) : null
        }
        <TagInput
            initial={eventRecord?.tags ?? ""}
            label="规范标签（至少一个）"
            available={canonicalTags}
            showRequiredIndicator={showRequiredIndicators}
            client:load
        />
        <div>
            <label class={labelCls} for="description">活动说明</label>
            <textarea
                id="description"
                name="description"
                class="mt-1.5 flex min-h-36 w-full resize-y rounded-md border border-border-strong bg-surface px-3 py-2 text-sm leading-6 text-foreground transition-[border-color,background-color,box-shadow] duration-300 ease-motion placeholder:text-muted focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/40 focus-visible:outline-none"
                >{value("description")}</textarea
            >
        </div>
    </section>

    <div
        class="sticky bottom-4 z-10 flex flex-col gap-3 rounded-md bg-surface-raised/96 p-3 shadow-popover ring-1 ring-border/80 backdrop-blur-xl sm:flex-row sm:items-center sm:justify-between"
    >
        <p
            id={statusId}
            class="min-h-5 text-sm text-muted-foreground"
            role="status"
            aria-live="polite"
        >
            {statusText}
        </p>
        <div class="flex gap-2">
            <a
                class="inline-flex h-10 flex-1 items-center justify-center rounded-md bg-surface-subtle px-4 text-sm font-semibold text-foreground transition-[transform,background-color] duration-300 ease-motion focus-visible:ring-2 focus-visible:ring-ring/60 focus-visible:outline-none active:scale-[0.98] sm:flex-none"
                href={cancelHref}
            >
                取消
            </a>
            <button
                id={submitButtonId}
                class="inline-flex h-10 flex-1 items-center justify-center gap-2 rounded-md bg-primary px-5 text-sm font-semibold text-primary-foreground transition-[transform,background-color] duration-300 ease-motion hover:bg-primary/90 focus-visible:ring-2 focus-visible:ring-ring/60 focus-visible:outline-none active:scale-[0.98] disabled:pointer-events-none disabled:opacity-50 disabled:active:scale-100 sm:flex-none"
                type="submit"
            >
                <Save class="size-4" aria-hidden="true" />
                <span data-save-label>{submitLabel}</span>
            </button>
        </div>
    </div>
</form>
