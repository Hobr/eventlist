---
import Save from "phosphor-svelte/lib/FloppyDisk";
import DivisionPicker from "../DivisionPicker.svelte";
import SelectField from "../SelectField.svelte";
import TagInput from "../TagInput.svelte";
import Button from "../ui/button.svelte";
import Input from "../ui/input.svelte";
import Label from "../ui/label.svelte";
import Textarea from "../ui/textarea.svelte";
import type { AdminEventField, AdminEventRawInput } from "../../lib/admin/form";
import type { EventRecord } from "../../lib/db/admin-events";
import type { TagSummary } from "../../lib/db/tags";
import {
    EVENT_ADMISSION_METHODS,
    EVENT_SCALES,
    EVENT_SCHEDULE_STATUSES,
    EVENT_TYPES
} from "../../lib/events/options";

interface Props {
    eventRecord?: EventRecord | null;
    canonicalTags: TagSummary[];
    formId: string;
    cancelHref: string;
    submitButtonId: string;
    statusId: string;
    submitLabel: string;
    statusText: string;
    defaultDivisionCode?: string;
    showRequiredIndicators?: boolean;
    initialValues?: AdminEventRawInput;
    sourceReadOnly?: boolean;
    submitDisabled?: boolean;
}

const {
    eventRecord = null,
    canonicalTags,
    formId,
    cancelHref,
    submitButtonId,
    statusId,
    submitLabel,
    statusText,
    defaultDivisionCode = "",
    showRequiredIndicators = false,
    initialValues = {},
    sourceReadOnly = false,
    submitDisabled = false
} = Astro.props;

const typeOptions = EVENT_TYPES.map((type) => ({ value: type.name, label: type.label }));
const scaleOptions = EVENT_SCALES.map((scale) => ({ value: scale.name, label: scale.label }));
const scheduleStatusOptions = EVENT_SCHEDULE_STATUSES.map((status) => ({
    value: status.name,
    label: status.label
}));
const admissionMethodOptions = EVENT_ADMISSION_METHODS.map((method) => ({
    value: method.name,
    label: method.label
}));
const headingId = (name: string) => `${formId}-${name}-heading`;
const value = (name: AdminEventField) => {
    const current = eventRecord?.[name];
    if (typeof current === "string") return current;
    const initial = initialValues[name];
    return typeof initial === "string" ? initial : "";
};
---

<form
    id={formId}
    data-event-id={eventRecord?.id}
    data-return-href={cancelHref}
    class="admin-event-form"
>
    <slot name="metadata" />

    <section class="admin-form-section" aria-labelledby={headingId("identity")}>
        <div class="wide">
            <h2 id={headingId("identity")} class="admin-section-title">活动识别</h2>
            <p class="admin-section-note">用清晰、可检索的名称与分类描述活动</p>
        </div>
        <div class="wide">
            <Label for="title">
                活动名称
                {showRequiredIndicators ? <span class="required-indicator">必填</span> : null}
            </Label>
            <Input
                id="title"
                name="title"
                required
                value={value("title")}
                class="field-control-spacing"
            />
        </div>
        <SelectField
            name="type"
            label="类型"
            value={value("type")}
            options={typeOptions}
            required
            showRequiredIndicator={showRequiredIndicators}
            client:load
        />
        <SelectField
            name="scale"
            label="规模"
            value={value("scale")}
            options={scaleOptions}
            required
            showRequiredIndicator={showRequiredIndicators}
            client:load
        />
    </section>

    <section class="admin-form-section" aria-labelledby={headingId("schedule")}>
        <div class="wide">
            <h2 id={headingId("schedule")} class="admin-section-title">时间与地点</h2>
        </div>
        <div class="wide">
            <DivisionPicker
                name="division_code"
                value={eventRecord?.division_code ??
                    initialValues.division_code ??
                    defaultDivisionCode}
                label="地区"
                mode="county"
                required
                showRequiredIndicator={showRequiredIndicators}
                wide
                client:load
            />
        </div>
        <div>
            <Label for="venue">
                场馆
                {showRequiredIndicators ? <span class="required-indicator">必填</span> : null}
            </Label>
            <Input
                id="venue"
                name="venue"
                required
                value={value("venue")}
                class="field-control-spacing"
            />
        </div>
        <div>
            <Label for="address">详细地址</Label>
            <Input
                id="address"
                name="address"
                value={value("address")}
                class="field-control-spacing"
            />
        </div>
        <div>
            <Label for="start_date">
                开始日期
                {showRequiredIndicators ? <span class="required-indicator">必填</span> : null}
            </Label>
            <Input
                id="start_date"
                name="start_date"
                type="date"
                required
                value={value("start_date")}
                class="field-control-spacing"
            />
        </div>
        <div>
            <Label for="end_date">
                结束日期
                {showRequiredIndicators ? <span class="required-indicator">必填</span> : null}
            </Label>
            <Input
                id="end_date"
                name="end_date"
                type="date"
                required
                value={value("end_date")}
                class="field-control-spacing"
            />
        </div>
        <div>
            <Label for="start_time">开始时间(选填)</Label>
            <Input
                id="start_time"
                name="start_time"
                type="time"
                value={value("start_time")}
                class="field-control-spacing"
            />
        </div>
        <div>
            <Label for="end_time">结束时间(选填)</Label>
            <Input
                id="end_time"
                name="end_time"
                type="time"
                value={value("end_time")}
                class="field-control-spacing"
            />
        </div>
    </section>

    <section class="admin-form-section" aria-labelledby={headingId("links")}>
        <div class="wide">
            <h2 id={headingId("links")} class="admin-section-title">来源与参与信息</h2>
        </div>
        <div class="wide">
            <Label for="source_url">
                来源链接
                {showRequiredIndicators ? <span class="required-indicator">必填</span> : null}
            </Label>
            <Input
                id="source_url"
                name="source_url"
                type="url"
                required
                value={value("source_url")}
                readonly={sourceReadOnly}
                aria-describedby={sourceReadOnly ? `${formId}-source-note` : undefined}
                class="field-control-spacing"
            />
            {
                sourceReadOnly ? (
                    <p id={`${formId}-source-note`} class="field-note">
                        由会员购活动 ID 生成, 作为重复检测和审计标识, 不能修改
                    </p>
                ) : null
            }
        </div>
        <div class="wide">
            <Label for="organizer">主办方</Label>
            <Input
                id="organizer"
                name="organizer"
                maxlength="200"
                value={value("organizer")}
                class="field-control-spacing"
            />
        </div>
        <SelectField
            name="schedule_status"
            label="活动异常状态"
            value={value("schedule_status")}
            options={scheduleStatusOptions}
            placeholder="正常"
            client:load
        />
        <SelectField
            name="admission_method"
            label="入场方式"
            value={value("admission_method")}
            options={admissionMethodOptions}
            placeholder="选择入场方式"
            client:load
        />
        <div class="wide">
            <Label for="price_range">票价区间</Label>
            <Input
                id="price_range"
                name="price_range"
                maxlength="120"
                value={value("price_range")}
                class="field-control-spacing"
            />
        </div>
        <div>
            <Label for="admission_start_date">开始购票/预约/申请日期</Label>
            <Input
                id="admission_start_date"
                name="admission_start_date"
                type="date"
                value={value("admission_start_date")}
                class="field-control-spacing"
            />
        </div>
        <div>
            <Label for="admission_start_time">开始购票/预约/申请时间</Label>
            <Input
                id="admission_start_time"
                name="admission_start_time"
                type="time"
                value={value("admission_start_time")}
                class="field-control-spacing"
            />
        </div>
        <div>
            <Label for="submitter_contact">
                投稿联系方式
                {showRequiredIndicators ? <span class="required-indicator">必填</span> : null}
            </Label>
            <Input
                id="submitter_contact"
                name="submitter_contact"
                required
                value={value("submitter_contact")}
                class="field-control-spacing"
            />
        </div>
        <div>
            <Label for="ticket_url">购票地址</Label>
            <Input
                id="ticket_url"
                name="ticket_url"
                type="url"
                value={value("ticket_url")}
                class="field-control-spacing"
            />
        </div>
        <div>
            <Label for="qq_group">官方交流群</Label>
            <Input
                id="qq_group"
                name="qq_group"
                value={value("qq_group")}
                class="field-control-spacing"
            />
        </div>
        <div>
            <Label for="cover_url">封面 URL</Label>
            <Input
                id="cover_url"
                name="cover_url"
                type="url"
                pattern="https://.*"
                value={value("cover_url")}
                class="field-control-spacing"
            />
        </div>
    </section>

    <section
        class="admin-form-section admin-content-section"
        aria-labelledby={headingId("content")}
    >
        <div>
            <h2 id={headingId("content")} class="admin-section-title">公开内容</h2>
        </div>
        {
            eventRecord?.tag_suggestions ? (
                <div class="admin-tag-suggestion">
                    <p>投稿标签建议</p>
                    <p>{eventRecord.tag_suggestions}</p>
                </div>
            ) : null
        }
        <TagInput
            initial={eventRecord?.tags ?? initialValues.tags ?? ""}
            label="规范标签(至少一个)"
            available={canonicalTags}
            showRequiredIndicator={showRequiredIndicators}
            client:load
        />
        <div>
            <Label for="description">活动说明</Label>
            <Textarea
                id="description"
                name="description"
                value={value("description")}
                class="admin-description-field"
            />
        </div>
    </section>

    <div class="admin-form-actions">
        <p id={statusId} class="admin-form-status" role="status" aria-live="polite" tabindex="-1">
            {statusText}
        </p>
        <div class="admin-form-buttons">
            <Button href={cancelHref} variant="outline"> 取消 </Button>
            <Button id={submitButtonId} type="submit" disabled={submitDisabled}>
                <Save size={17} aria-hidden="true" />
                <span data-save-label>{submitLabel}</span>
            </Button>
        </div>
    </div>
</form>
